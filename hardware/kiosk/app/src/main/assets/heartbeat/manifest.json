{
  "manifest_version": 2,
  "name": "Dayframe local liveness probe",
  "version": "1.0.0",
  "browser_specific_settings": {"gecko": {"id": "heartbeat@dayframe.local"}},
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ],
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["heartbeat.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
