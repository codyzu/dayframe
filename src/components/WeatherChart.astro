<div
  class="mt-3 min-[1000px]:mt-2 min-[1000px]:flex min-[1000px]:grow min-[1000px]:flex-col group-data-[observance=true]/weather:mt-1 min-[1000px]:group-data-[alert=true]/weather:mt-1"
  data-chart
>
  <p data-chart-empty class="py-5 text-secondary">
    En attente des prévisions…
  </p>
  <div
    data-chart-content
    class="w-full min-[1000px]:flex min-[1000px]:grow min-[1000px]:flex-col"
    hidden
  >
    <div class="hourly-layout min-[1000px]:grow">
      <div class="temperature-key text-secondary leading-tight">
        <p class="text-sm font-bold text-temperature">Température</p>
        <p data-chart-range></p>
      </div>
      <div class="rain-key text-secondary leading-tight">
        <p class="text-sm font-bold text-rain">Pluie</p>
        <p>Probabilité</p>
      </div>
      <div
        class="hourly-plot relative grid grid-rows-2"
        data-chart-plot
        role="img"
        aria-label="Température et probabilité de précipitations"
        aria-describedby="chart-description"
      >
        <p id="chart-description" class="sr-only">
          En haut, température en degrés Celsius. En bas, maximum des
          probabilités horaires de chaque tranche de deux heures, de 0 à 100 %.
          Le trait pointillé indique l’heure actuelle. Les traits cuivre
          indiquent le lever et le coucher du soleil lorsqu’ils sont dans la
          plage du graphique. Le tableau détaillé suit le graphique.
        </p>
        <div class="relative pb-2 pt-4">
          <svg
            class="block size-full overflow-visible border-b border-border/60"
            viewBox="0 0 600 100"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <path
              data-chart-curve
              fill="none"
              stroke="var(--colors-temperature)"
              stroke-width="3.5"
              stroke-linecap="round"
              vector-effect="non-scaling-stroke"
            />
          </svg>
        </div>
        <div class="rain-track relative border-t border-border/45">
          <svg
            class="rain-marks absolute inset-x-0 bottom-0 w-full overflow-visible border-b border-border/60"
            viewBox="0 20 600 80"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <line
              x1="0"
              x2="600"
              y1="20"
              y2="20"
              stroke="var(--colors-border)"
              stroke-dasharray="3 5"
              vector-effect="non-scaling-stroke"
            />
            <g data-chart-rain></g>
          </svg>
          <div
            data-rain-peak
            class="absolute z-1 -translate-x-1/2 whitespace-nowrap rounded bg-surface px-1 text-[length:var(--font-chart-time)] leading-none font-bold tabular-nums text-rain"
            hidden
          ></div>
          <div
            data-rain-scale
            class="rain-scale absolute inset-y-0 left-full text-sm font-bold text-rain"
            aria-hidden="true"
          >
            <span class="absolute right-0 -translate-y-1/2">100 %</span>
            <span class="absolute bottom-0 right-0 translate-y-1/2">0 %</span>
          </div>
        </div>
        <svg
          class="now-marker pointer-events-none absolute inset-x-0 bottom-0 w-full"
          viewBox="0 0 600 100"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <g
            stroke="var(--colors-temperature)"
            stroke-dasharray="1 4"
            stroke-linecap="round"
          >
            <line
              data-daylight-marker="sunrise"
              x1="0"
              x2="0"
              y1="0"
              y2="100"
              vector-effect="non-scaling-stroke"
              style="display:none"
            />
            <line
              data-daylight-marker="sunset"
              x1="0"
              x2="0"
              y1="0"
              y2="100"
              vector-effect="non-scaling-stroke"
              style="display:none"
            />
          </g>
          <line
            data-weather-now-line
            x1="0"
            x2="0"
            y1="0"
            y2="100"
            stroke="var(--colors-secondary)"
            stroke-dasharray="3 4"
            vector-effect="non-scaling-stroke"
            style="display:none"
          />
        </svg>
        <span
          data-weather-now-label
          class="absolute top-0 whitespace-nowrap bg-surface px-1 text-sm font-semibold leading-none"
          hidden
        >
          Maintenant
        </span>
      </div>
      <div
        data-chart-times
        class="hourly-times relative mt-1 h-6"
        aria-hidden="true"
      ></div>
    </div>
    <ul
      data-chart-daylight
      class="flex flex-wrap justify-between gap-x-4 gap-y-1 text-sm text-secondary"
      aria-label="Heures de lever et coucher du soleil"
      hidden
    >
      <li
        data-daylight-entry="sunrise"
        class="flex items-center gap-1.5"
        hidden
      >
        <span
          class="solar-icon i-meteocons-sunrise-fill size-6 shrink-0"
          aria-hidden="true"
        ></span>
        Lever du soleil <time class="font-bold tabular-nums"></time>
      </li>
      <li data-daylight-entry="sunset" class="flex items-center gap-1.5" hidden>
        <span
          class="solar-icon i-meteocons-sunset-fill size-6 shrink-0"
          aria-hidden="true"
        ></span>
        Coucher du soleil <time class="font-bold tabular-nums"></time>
      </li>
    </ul>
    <div class="sr-only">
      <table>
        <caption>Prévisions horaires, heure locale</caption>
        <thead>
          <tr>
            <th>Heure</th>
            <th>Température</th>
            <th>Précipitations</th>
            <th>Conditions</th>
          </tr>
        </thead>
        <tbody data-chart-hours></tbody>
      </table>
    </div>
  </div>
  <!-- An SVG wrapper keeps cloned rain bars in the SVG namespace. -->
  <template data-rain-bar-template>
    <svg>
      <rect rx="4" fill="var(--colors-rain)" fill-opacity="0.85">
        <title></title>
      </rect>
    </svg>
  </template>
  <template data-chart-time-template>
    <span class="absolute -translate-x-1/2 text-[length:var(--font-chart-time)] text-secondary max-sm:data-[minor=true]:hidden"></span>
  </template>
  <template data-chart-hour-template>
    <tr>
      <th data-hour-time scope="row"></th>
      <td data-hour-temperature></td>
      <td data-hour-rain></td>
      <td data-hour-condition></td>
    </tr>
  </template>
</div>
<style>
  /* Solar symbols are legend keys. Reuse the bundled static versions. */
  .solar-icon {
    background-image: var(--dayframe-static-icon);
  }
  .hourly-layout {
    --rain-label-space: 1.25rem;
    --rain-scale-width: 3rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--rain-scale-width);
    grid-template-areas: 'keys keys' 'plot .' 'times .';
    padding-inline: 0.75rem 0;
  }
  .temperature-key {
    grid-area: temperature;
  }
  .rain-key {
    grid-area: rain;
  }
  .hourly-plot {
    grid-area: plot;
    height: 7.75rem;
  }
  .hourly-times {
    grid-area: times;
  }
  .rain-track {
    /* A full-height bar still leaves room for its 100% label. */
    --rain-height: calc(100% - var(--rain-label-space));
  }
  .rain-marks {
    height: var(--rain-height);
  }
  .now-marker {
    height: calc(100% - 1rem);
  }
  .rain-scale {
    width: var(--rain-scale-width);
  }
  .rain-scale > span:first-child {
    top: var(--rain-label-space);
  }
  @media (max-width: 639px) {
    .temperature-key,
    .rain-key {
      grid-area: keys;
      padding-bottom: 0.5rem;
    }
    .rain-key {
      justify-self: end;
    }
  }
  @media (min-width: 640px) {
    .hourly-layout {
      grid-template-columns: 7.5rem minmax(0, 1fr) var(--rain-scale-width);
      grid-template-areas: 'temperature plot .' 'rain plot .' '. times .';
      grid-template-rows: 1fr 1fr auto;
      padding-inline-start: 0;
    }
    .temperature-key,
    .rain-key {
      align-self: center;
    }
  }
  @media (min-width: 1000px) {
    /* The tracks fill the available height. Their SVGs scale with the grid
       without contributing an intrinsic height during flex sizing. */
    .hourly-plot {
      contain: size;
      height: auto;
      min-height: 7.75rem;
    }
    /* Reserve room for compact warnings while letting both tracks grow. */
    :global([data-weather][data-alert='true']) .hourly-plot {
      min-height: 5.875rem;
    }
  }
</style>
