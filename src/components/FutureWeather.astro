---
import ForecastDayChart from './ForecastDayChart.astro';
---

<button
  type="button"
  data-forecast-open
  class="rounded-xl border border-border px-3 py-1 min-h-11 leading-tight text-[length:var(--font-weather-detail)] font-bold hover:bg-elevated focus-visible:outline-2 focus-visible:outline-accent"
  aria-haspopup="dialog"
>
  Prévisions sur 7 jours
</button>
<dialog
  data-forecast-dialog
  aria-labelledby="future-weather-title"
  aria-describedby="future-weather-idle-help"
  class="m-auto w-[min(72rem,96vw)] max-h-[92dvh] overflow-y-auto rounded-3xl border border-border bg-surface text-primary p-4 shadow-xl"
>
  <div class="sticky top-0 z-1 bg-surface flex items-center justify-between gap-4">
    <h2 id="future-weather-title" class="text-xl font-bold">
      Prévisions sur 7 jours
    </h2>
    <button
      type="button"
      data-forecast-close
      autofocus
      class="rounded-xl border border-border px-4 py-2 min-h-11 font-bold hover:bg-elevated"
    >
      Fermer
    </button>
  </div>
  <p id="future-weather-idle-help" class="sr-only">
    Fermeture automatique après une minute sans interaction. Touchez l’écran,
    utilisez le clavier ou faites défiler pour prolonger la consultation.
  </p>
  <p
    data-future-status
    role="status"
    class="mt-2 text-[length:var(--font-weather-detail)] text-secondary"
  ></p>
  <div
    data-future-days
    class="mt-3 flex gap-2 overflow-x-auto pb-2 min-[1000px]:grid min-[1000px]:grid-cols-7"
    role="group"
    aria-label="Choisir une journée"
  ></div>
  <h3 data-future-heading class="mt-4 text-lg font-bold"></h3>
  <p
    data-future-summary
    role="status"
    class="mt-1 text-[length:var(--font-weather-detail)] font-bold"
  ></p>
  <p
    data-future-chart-note
    class="mt-1 text-[length:var(--font-weather-detail)] text-secondary"
    hidden
  ></p>
  <ForecastDayChart />
  <details data-future-details class="mt-3">
    <summary class="cursor-pointer min-h-11 py-2 font-bold text-[length:var(--font-weather-detail)] focus-visible:outline-2 focus-visible:outline-accent">
      Voir heure par heure
    </summary>
    <div data-future-detail-content>
      <p
        data-future-coverage
        class="text-[length:var(--font-weather-detail)] text-secondary"
      ></p>
      <div
        class="mt-2 max-h-[24dvh] overflow-auto rounded-xl border border-border"
        tabindex="0"
        role="region"
        aria-label="Prévisions heure par heure"
      >
        <table class="w-full text-[length:var(--font-weather-detail)] text-left">
          <thead>
            <tr>
              <th scope="col" class="p-2">
                Heure
              </th>
              <th scope="col" class="p-2">
                Temp.
              </th>
              <th scope="col" class="p-2">
                Pluie
              </th>
              <th scope="col" class="p-2">
                Conditions
              </th>
            </tr>
          </thead>
          <tbody data-future-hours></tbody>
        </table>
      </div>
    </div>
  </details>
  <p class="mt-3 text-sm text-secondary">
    <a
      href="https://open-meteo.com/"
      target="_blank"
      rel="noreferrer"
      class="underline"
    >
      Prévisions : Open-Meteo
    </a>
    {' · '}
    <a
      href="https://creativecommons.org/licenses/by/4.0/"
      target="_blank"
      rel="noreferrer"
      class="underline"
    >
      CC BY 4.0
    </a>
    {' · présentation adaptée'}
  </p>
  <template data-future-day-template>
    <button
      type="button"
      class="relative grid grid-cols-[2.5rem_minmax(0,1fr)] items-center gap-x-1 shrink-0 w-40 min-[1000px]:w-auto rounded-xl border border-border p-2 min-h-11 min-w-0 break-words text-center text-[length:var(--font-weather-detail)] hover:bg-elevated aria-pressed:bg-advice aria-pressed:border-accent focus-visible:outline-2 focus-visible:outline-accent"
    >
      <span data-future-date class="col-span-2 font-bold"></span>
      <span
        data-future-icon
        aria-hidden="true"
        class="inline-block size-10 shrink-0"
      ></span>
      <span data-future-condition class="sr-only"></span>
      <span data-future-extremes class="font-bold"></span>
      <span data-future-rain class="col-span-2"></span>
    </button>
  </template>
</dialog>
<style>
  /* Dialog top layer keeps browsing independent of kiosk navigation and mode layout. */
  dialog::backdrop {
    background: #182c35b3;
  }
  /* WebKit can count closed details content in the dialog's scroll width.
     Remove its layout explicitly while preserving the native disclosure. */
  [data-future-details]:not([open]) > [data-future-detail-content] {
    display: none;
  }
  [data-future-icon] {
    background-image: var(--dayframe-static-icon);
  }
</style>
