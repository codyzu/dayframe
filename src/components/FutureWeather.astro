<nav
  data-future-days
  class="flex min-w-0 max-w-full gap-2 overflow-x-auto p-2 scroll-p-2 min-[1000px]:grid min-[1000px]:grid-cols-7"
  aria-label="Choisir le jour de la météo"
></nav>
<template data-future-day-template>
  <button
    type="button"
    class="future-day relative flex flex-col items-center justify-center gap-0 shrink-0 w-40 min-[1000px]:w-auto min-w-0 min-h-12 rounded-2xl border border-transparent bg-surface px-2 py-0.5 text-[length:var(--font-weather-detail)] leading-tight hover:bg-elevated aria-pressed:bg-primary aria-pressed:hover:bg-primary aria-pressed:text-surface focus-visible:outline-2 focus-visible:outline-accent"
  >
    <span class="flex items-center justify-center gap-1">
      <span data-future-date class="font-bold text-lg"></span>
      <span
        data-future-icon
        aria-hidden="true"
        class="inline-block size-7 shrink-0"
      ></span>
    </span>
    <span data-future-condition class="sr-only"></span>
    <span data-future-extremes class="text-base whitespace-nowrap"></span>
    <span data-future-rain class="font-bold"></span>
  </button>
</template>
<style>
  /* Keep seven simultaneous forecasts still on the low-power household frame. */
  [data-future-icon] {
    background-image: var(--dayframe-static-icon);
  }
</style>
