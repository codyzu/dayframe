---
const modes = [
  {id: 'morning', label: 'Matin'},
  {id: 'photos', label: 'Photos'},
  {id: 'night', label: 'Nuit'},
];
---

<nav
  class="flex w-full justify-between gap-2 rounded-full border border-border bg-surface p-2"
  aria-label="Modes d’affichage"
>
  {modes.map(({id, label}) => (
    <button
      class="min-h-12 flex-1 rounded-full px-3 text-[length:var(--font-navigation)] text-secondary transition-colors hover:bg-background aria-pressed:bg-primary aria-pressed:text-surface aria-pressed:font-bold aria-pressed:hover:bg-primary"
      type="button"
      data-mode-button={id}
      aria-pressed={id === 'morning'}
    >
      {label}
    </button>
  ))}
</nav>
