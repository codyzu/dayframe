---
const modes = [
  {id: 'morning', label: 'Matin'},
  {id: 'photos', label: 'Photos'},
  {id: 'night', label: 'Nuit'},
];
---

<nav
  class="flex w-full justify-between gap-1 rounded-full border border-border bg-surface p-1.25 md:w-auto"
  aria-label="Modes d’affichage"
>
  {modes.map(({id, label}) => (
    <button
      class="min-h-11 rounded-full px-4 text-[length:var(--font-navigation)] text-secondary transition-colors hover:bg-background aria-pressed:bg-primary aria-pressed:text-surface aria-pressed:font-bold aria-pressed:hover:bg-primary md:min-w-20 md:px-5"
      type="button"
      data-mode-button={id}
      aria-pressed={id === 'morning'}
    >
      {label}
    </button>
  ))}
</nav>
