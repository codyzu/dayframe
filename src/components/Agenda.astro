---
// Future authorized calendar readers can pass events; never prerender private data.
interface Props {
  events?: Array<{time: string; title: string}>;
}
const {events = []} = Astro.props;
---

<section
  class:list={['surface px-4', events.length > 0 ? 'py-3' : 'py-4']}
  aria-labelledby="agenda-title"
>
  <h2
    id="agenda-title"
    class="text-[length:var(--font-weather-heading)] font-bold leading-tight"
  >
    Aujourd’hui
  </h2>
  {events.length > 0 ? (
    <ul class="mt-2 space-y-1">
      {events.slice(0, 3).map((event) => (
        <li class="flex items-baseline gap-4 text-[length:var(--font-weather-detail)] leading-tight">
          <span class="font-bold tabular-nums">{event.time}</span>
          <span>{event.title}</span>
        </li>
      ))}
    </ul>
  ) : (
    <p class="mt-2 text-[length:var(--font-weather-detail)] text-secondary leading-snug">
      Aucun agenda connecté.
      <br />
      Une journée à organiser ensemble.
    </p>
  )}
</section>
