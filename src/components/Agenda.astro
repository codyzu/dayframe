<section
  data-agenda
  class="min-w-0 px-4 py-4 min-[1000px]:px-6 min-[1000px]:py-5"
  aria-labelledby="agenda-title"
>
  <h2 id="agenda-title" class="text-3xl leading-tight font-bold tracking-tight">
    Aujourd’hui
  </h2>
  <ul data-day-observance hidden class="my-2 grid gap-1"></ul>
  <p data-agenda-status class="mt-1 text-base text-secondary leading-snug">
    Aucun agenda connecté.
  </p>
  <ol data-agenda-events hidden class="mt-2"></ol>
  <section data-agenda-tomorrow hidden aria-labelledby="agenda-tomorrow-title">
    <h3
      id="agenda-tomorrow-title"
      data-agenda-tomorrow-title
      class="mt-2 border-b border-border/60 px-1 pb-1 text-secondary text-lg font-bold leading-tight"
    ></h3>
    <ol data-agenda-tomorrow-events hidden></ol>
    <p
      data-agenda-tomorrow-empty
      hidden
      class="mt-1 px-1 text-secondary text-base leading-tight"
    >
      Aucun événement prévu.
    </p>
  </section>
  <template data-agenda-template>
    <li class="agenda-entry group/event grid min-h-11 min-w-0 grid-cols-[4.5rem_minmax(0,1fr)_auto] items-center gap-1 border-b border-border/50 px-1 py-0.5 text-primary leading-tight last:border-b-transparent data-[next]:rounded-md data-[next]:border-b-transparent data-[next]:bg-alpine-near/40">
      <span data-event-time class="font-bold tabular-nums text-base"></span>
      <div class="min-w-0">
        <div class="flex min-w-0 items-center gap-1">
          <span
            data-birthday-icon
            hidden
            role="img"
            aria-label="Anniversaire"
            class="shrink-0 text-accent"
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
              <path
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M4 21h16v-6a3 3 0 0 0-3-3H7a3 3 0 0 0-3 3v6Zm0-5c2 0 2 2 4 2s2-2 4-2 2 2 4 2 2-2 4-2M8 12V8m4 4V8m4 4V8M8 5V4m4 1V3m4 2V4"
              />
            </svg>
          </span>
          <span
            data-event-title
            class="block truncate text-[length:var(--font-weather-detail)] data-[next]:font-bold"
          ></span>
        </div>
        <span
          data-event-source
          class="block w-fit rounded-sm px-1 text-[0.8125rem] font-bold text-secondary group-data-[event-calendar=family]/event:bg-alpine-near/45 group-data-[event-calendar=family]/event:text-primary group-data-[event-calendar=massages]/event:bg-[#e8def5] group-data-[event-calendar=massages]/event:text-[#523772]"
        ></span>
      </div>
      <span
        data-event-weather
        hidden
        class="flex items-center gap-1 whitespace-nowrap tabular-nums text-base text-primary"
      >
        <span
          data-event-weather-icon
          class="size-8 shrink-0"
          aria-hidden="true"
        ></span>
        <b data-event-temperature></b>
        <svg
          viewBox="0 0 16 20"
          width="11"
          height="14"
          class="ml-1 shrink-0 text-rain"
          aria-hidden="true"
        >
          <path
            fill="currentColor"
            d="M8 0C6 4 1 8.1 1 12.5A7 7 0 0 0 15 12.5C15 8.1 10 4 8 0Z"
          />
        </svg>
        <span
          data-event-rain
          class="min-w-9 text-right font-bold text-rain"
        ></span>
      </span>
    </li>
  </template>
  <template data-observance-template>
    <li class="min-w-0 flex flex-wrap items-baseline gap-x-2 gap-y-0.5 rounded-md bg-advice-soft px-2 py-1 text-advice-ink">
      <span
        data-observance-name
        class="min-w-0 truncate text-base font-bold"
      ></span>
      <span data-observance-tags class="flex flex-wrap gap-1"></span>
    </li>
  </template>
  <template data-observance-tag-template>
    <span class="rounded-sm bg-surface px-1.5 text-[0.8125rem] font-bold leading-relaxed data-[type=school]:bg-alpine-near/45 data-[type=observed]:bg-[#e8def5] data-[type=observed]:text-[#523772]"></span>
  </template>
</section>

<style>
  [data-event-weather-icon] {
    background-image: var(--dayframe-static-icon);
  }

  @media (max-width: 420px) {
    /* Put the source and weather under long event names on narrow displays. */
    [data-event-weather] {
      grid-column: 2;
    }
  }
</style>
