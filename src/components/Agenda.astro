<section
  data-agenda
  class="surface px-4 py-2 min-w-0"
  aria-labelledby="agenda-title"
>
  <h2
    id="agenda-title"
    class="text-[length:var(--font-weather-heading)] font-bold leading-tight"
  >
    Aujourd’hui
  </h2>
  <p
    data-agenda-status
    class="mt-2 text-[length:var(--font-weather-detail)] text-secondary leading-snug"
  >
    Aucun agenda connecté.
  </p>
  <ul data-agenda-events hidden class="mt-2 space-y-1"></ul>
  <template data-agenda-template>
    <li class="flex items-baseline gap-3 min-w-0 text-[length:var(--font-weather-detail)] leading-tight">
      <span data-event-time class="shrink-0 font-bold tabular-nums"></span>
      <span data-event-title class="min-w-0 truncate"></span>
    </li>
  </template>
</section>
