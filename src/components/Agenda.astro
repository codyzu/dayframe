<section
  data-agenda
  class="surface px-4 py-2 min-w-0"
  aria-labelledby="agenda-title"
>
  <h2
    id="agenda-title"
    class="text-[length:var(--font-weather-heading)] font-bold leading-tight"
  >
    La suite de la journée
  </h2>
  <p
    data-day-observance
    hidden
    class="mt-1 truncate rounded-md bg-advice px-2 text-advice-ink text-[length:var(--font-weather-detail)] leading-tight"
  ></p>
  <p
    data-agenda-status
    class="mt-2 text-[length:var(--font-weather-detail)] text-secondary leading-snug"
  >
    Aucun agenda connecté.
  </p>
  <ul data-agenda-events hidden class="mt-2 grid gap-0.75"></ul>
  <template data-agenda-template>
    <li class="flex items-baseline gap-3 min-w-0 rounded-md px-2 text-primary text-[length:var(--font-weather-detail)] leading-tight data-[event-calendar=family]:bg-[#f5dadd] data-[event-calendar=massages]:bg-[#e8def5]">
      <span
        data-event-time
        class="shrink-0 font-bold tabular-nums min-w-22"
      ></span>
      <span data-event-title class="min-w-0 flex-1 truncate"></span>
      <span data-event-source class="shrink-0 text-sm font-bold"></span>
    </li>
  </template>
</section>
