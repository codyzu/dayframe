---
import '../styles/fluent-emoji.css';
---

<section
  data-agenda
  class="bg-surface min-w-0 px-4 py-4 min-[1000px]:px-6 min-[1000px]:pt-5 min-[1000px]:pb-1"
  aria-labelledby="agenda-title"
>
  <h2 id="agenda-title" class="text-3xl leading-tight font-bold tracking-tight">
    Aujourd’hui
  </h2>
  <ul data-day-observance hidden class="my-2 grid gap-1"></ul>
  <p data-agenda-status class="mt-1 text-base text-secondary leading-snug">
    Aucun agenda connecté.
  </p>
  <ol data-agenda-events hidden class="mt-2 grid gap-1"></ol>
  <section data-agenda-tomorrow hidden aria-labelledby="agenda-tomorrow-title">
    <h3
      id="agenda-tomorrow-title"
      data-agenda-tomorrow-title
      class="mt-2 border-b border-border/60 px-1 pb-1 text-secondary text-lg font-bold leading-tight"
    ></h3>
    <ol data-agenda-tomorrow-events hidden class="grid gap-1"></ol>
    <p
      data-agenda-tomorrow-empty
      hidden
      class="mt-1 px-1 text-secondary text-base leading-tight"
    >
      Aucun événement prévu.
    </p>
  </section>
  <template data-agenda-template>
    <li class="agenda-entry grid min-h-14 min-w-0 grid-cols-[4.5rem_minmax(0,1fr)_auto] min-[421px]:grid-cols-[5.25rem_minmax(0,1fr)_auto] items-center gap-1 rounded-md border-s-7 border-[var(--agenda-accent)] bg-[var(--agenda-tint)] ps-1.5 pe-1 py-0.5 text-primary leading-tight data-[next]:ring-1 data-[next]:ring-inset data-[next]:ring-[var(--agenda-accent)]">
      <span class="flex min-w-0 flex-col items-start tabular-nums text-base">
        <span data-event-ongoing hidden class="sr-only">
          En cours.
        </span>
        <span
          data-event-time
          class="font-bold data-[muted]:font-semibold data-[muted]:text-secondary"
        ></span>
        <span
          data-event-end
          hidden
          class="flex flex-wrap items-baseline gap-x-1 text-secondary text-xs min-[421px]:text-sm data-[ongoing]:font-bold data-[ongoing]:text-primary data-[ongoing]:text-base"
        >
          <span data-event-end-clock></span>
          <span
            data-event-end-date
            hidden
            class="text-xs font-semibold text-secondary"
          ></span>
        </span>
      </span>
      <div class="flex min-w-0 items-center gap-1">
        <span
          data-birthday-icon
          hidden
          role="img"
          aria-label="Anniversaire"
          class="shrink-0 text-accent"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 21h16v-6a3 3 0 0 0-3-3H7a3 3 0 0 0-3 3v6Zm0-5c2 0 2 2 4 2s2-2 4-2 2 2 4 2 2-2 4-2M8 12V8m4 4V8m4 4V8M8 5V4m4 1V3m4 2V4"
            />
          </svg>
        </span>
        <span
          data-event-title
          class="min-w-0 line-clamp-2 break-words text-[length:var(--font-weather-detail)] data-[next]:font-bold"
        ></span>
      </div>
      <div class="flex flex-col items-end justify-end gap-x-2 min-[421px]:flex-row min-[421px]:items-center">
        <span
          data-event-weather
          hidden
          class="flex items-center gap-1 whitespace-nowrap tabular-nums text-sm text-primary min-[421px]:text-base"
        >
          <span
            data-event-weather-icon
            class="size-6 shrink-0 min-[421px]:size-8"
            aria-hidden="true"
          ></span>
          <b data-event-temperature></b>
          <svg
            viewBox="0 0 16 20"
            width="11"
            height="14"
            class="ml-1 shrink-0 text-rain"
            aria-hidden="true"
          >
            <path
              fill="currentColor"
              d="M8 0C6 4 1 8.1 1 12.5A7 7 0 0 0 15 12.5C15 8.1 10 4 8 0Z"
            />
          </svg>
          <span
            data-event-rain
            class="min-w-9 text-right font-bold text-rain"
          ></span>
        </span>
        <span class="flex items-center justify-end gap-x-1 min-[421px]:flex-col min-[421px]:items-end">
          <span
            data-event-source
            class="whitespace-nowrap rounded-sm bg-background px-1 text-[0.8125rem] font-bold text-primary"
          ></span>
          <span
            data-event-duration
            hidden
            class="order-first whitespace-nowrap px-1 text-xs tabular-nums text-secondary min-[421px]:order-none min-[421px]:text-sm"
          ></span>
        </span>
      </div>
    </li>
  </template>
  <template data-observance-template>
    <li class="min-w-0 flex flex-wrap items-baseline gap-x-2 gap-y-0.5 rounded-md border-s-7 border-[#8ac9f1] bg-[#203749] px-2 py-1 text-primary">
      <span
        data-observance-name
        class="min-w-0 truncate text-base font-bold"
      ></span>
      <span
        data-observance-tags
        class="ms-auto flex flex-wrap justify-end gap-1"
      ></span>
    </li>
  </template>
  <template data-observance-tag-template>
    <span class="rounded-sm bg-surface px-1.5 text-[0.8125rem] font-bold leading-relaxed text-primary"></span>
  </template>
</section>

<style>
  /* Category tints and bands travel together, including the next-event outline. */
  .agenda-entry[data-event-calendar='family'] {
    --agenda-accent: #ef9196;
    --agenda-tint: #372631;
  }

  .agenda-entry[data-event-calendar='massages'] {
    --agenda-accent: #c5a8e5;
    --agenda-tint: #322c42;
  }

  .agenda-entry[data-event-calendar='routines'] {
    --agenda-accent: #ffc36e;
    --agenda-tint: #362d23;
  }

  [data-event-title] {
    font-family: Manrope, 'Fluent Emoji Flat', system-ui, sans-serif;
  }

  [data-event-weather-icon] {
    background-image: var(--dayframe-static-icon);
  }
</style>
