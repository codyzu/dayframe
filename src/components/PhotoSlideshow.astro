<section
  data-mode-panel="photos"
  data-slideshow
  aria-labelledby="photos-title"
  hidden
  class="relative flex-1 grid place-items-center min-h-[500px] md:min-h-0 text-center"
>
  <div
    data-photo-stage
    data-fit="cover"
    class="photo-stage fixed inset-0 bg-black"
  ></div>
  <div
    class="photo-at-a-glance fixed top-5 left-5 z-2 flex max-w-[calc(100vw-2.5rem)] flex-col items-start text-white"
    aria-label="Heure et météo extérieure"
  >
    <time
      data-clock
      class="text-7xl md:text-8xl font-semibold tabular-nums leading-none"
      aria-label="Heure locale"
    >
      --:--
    </time>
    <p class="mt-2 flex items-center gap-2 text-3xl md:text-4xl font-medium text-left leading-tight">
      <span
        data-photo-weather-icon
        class="i-meteocons-not-available-fill inline-block size-16 md:size-20 shrink-0 drop-shadow-[0_1px_2px_#000000]"
        aria-hidden="true"
      ></span>
      <span data-photo-temperature aria-label="Température extérieure">
        —°
      </span>
      <span aria-hidden="true">·</span>
      <span data-photo-condition class="min-w-0 text-xl md:text-2xl">
        Météo indisponible
      </span>
    </p>
    <p data-photo-weather-status class="mt-1 text-sm" hidden>
      Dernier relevé
    </p>
  </div>
  <div
    data-photo-empty
    class="surface relative z-1 mx-4 max-w-[650px] p-7 md:p-11"
  >
    <p class="eyebrow">Vos instants, au quotidien</p>
    <h1 class="display-title" id="photos-title">
      Une place pour vos souvenirs.
    </h1>
    <p class="mt-5 text-mist">
      Votre collection privée s’affiche ici une fois cet écran connecté.
    </p>
  </div>
  <div
    data-photo-controls
    class="fixed top-4 right-4 z-2 flex max-w-[calc(100vw-2rem)] flex-wrap items-center gap-3 rounded-xl bg-surface text-primary border border-border p-2 text-sm"
  >
    <label class="flex items-center gap-2">
      Cadrage
      <select
        data-photo-fit
        aria-label="Cadrage des photos"
        class="min-h-11 rounded-lg bg-elevated px-3 text-primary"
      >
        <option value="contain">Photo entière</option>
        <option value="cover">Remplir l’écran</option>
      </select>
    </label>
    <button
      data-photo-next
      type="button"
      class="min-h-11 rounded-lg border border-border px-3"
    >
      Suivante
    </button>
  </div>
  <details
    data-photo-offline-controls
    hidden
    class="fixed right-4 bottom-40 z-2 max-w-[min(28rem,calc(100vw-2rem))] rounded-xl bg-surface border border-border p-3 text-left text-sm"
  >
    <summary class="min-h-11 cursor-pointer content-center">
      Photos hors connexion
    </summary>
    <label class="flex min-h-11 items-center gap-3">
      <input type="checkbox" data-photo-offline class="size-5 shrink-0" />
      Conserver des photos hors connexion sur ce cadre
    </label>
    <p class="mt-1 text-mist">
      Jusqu’à 100 photos / 100 Mo, pendant 7 jours après vérification de
      l’accès. Copies lisibles hors ligne, même après révocation à distance.
    </p>
    <p data-photo-offline-status role="status" class="mt-1 text-mist"></p>
  </details>
  <p
    data-photo-status
    role="status"
    class="fixed bottom-24 left-4 right-4 z-2 mx-auto w-fit max-w-[90vw] rounded-xl bg-surface text-primary border border-border px-4 py-2 text-sm"
  ></p>
</section>
<style>
  /* Keep Photos calm; use the bundled Meteocons stills, as in the forecast. */
  [data-photo-weather-icon] {
    background-image: var(--dayframe-static-icon);
  }
  [data-photo-status]:empty {
    display: none;
  }
  .photo-at-a-glance {
    text-shadow:
      0 2px 8px rgb(0 0 0 / 95%),
      0 1px 2px rgb(0 0 0 / 95%);
    pointer-events: none;
  }
  /* Images are created at runtime; component-owned styling keeps sizing local. */
  .photo-stage :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: photo-appear 350ms ease-out;
  }
  .photo-stage[data-fit='contain'] :global(img) {
    object-fit: contain;
  }
  @keyframes photo-appear {
    from {
      opacity: 0.35;
    }
    to {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .photo-stage :global(img) {
      animation: none;
    }
  }
</style>
