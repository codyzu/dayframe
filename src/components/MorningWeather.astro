<div
  data-weather
  class="grid grid-cols-1 gap-4 min-[1000px]:grid-cols-[0.9fr_1.3fr] lg:gap-5.5"
>
  <section
    class="surface bg-[#0d2731]/95 min-w-0 flex flex-col p-6"
    aria-labelledby="weather-title"
  >
    <p
      class="mb-2 text-[length:var(--font-weather-heading)] font-semibold text-mist"
      id="weather-title"
      data-weather-heading
    >
      En ce moment
    </p>
    <div class="flex flex-wrap items-center gap-x-6">
      <span
        class="text-[length:var(--font-weather-temperature)] tracking-[-0.05em] leading-[1.15]"
        data-temperature
      >
        —°
      </span>
      <span
        class="weather-icon i-meteocons-not-available-fill inline-block size-[var(--icon-weather-current)] shrink-0"
        data-current-icon
        aria-hidden="true"
      ></span>
    </div>
    <p
      class="mt-0.5 text-[length:var(--font-weather-description)] font-semibold"
      data-condition
    >
      Chargement de la météo…
    </p>
    <p
      class="mt-2 text-[length:var(--font-weather-detail)] text-mist"
      data-extremes
    >
      Ressenti — · Max. — / Min. —
    </p>
    <div class="mt-5 border-t border-white/25 pt-4">
      <div>
        <strong
          class="text-[length:var(--font-weather-summary)] font-semibold leading-snug"
          data-rain
        >
          Prévisions en cours de chargement.
        </strong>
        <p
          class="mt-3 text-[length:var(--font-weather-secondary)] text-mist leading-snug"
          data-summary
        >
          La météo se met à jour automatiquement.
        </p>
      </div>
    </div>
  </section>
  <section
    class="surface bg-[#0d2731]/95 min-w-0 flex flex-col p-5 lg:p-7"
    aria-labelledby="forecast-title"
  >
    <h2
      class="text-[length:var(--font-weather-heading)] font-semibold tracking-tight"
      id="forecast-title"
    >
      Les prochaines heures
    </h2>
    <div class="flex-1 flex items-center" data-chart>
      <p class="py-10 text-mist">En attente des prévisions…</p>
    </div>
    <p
      class="text-[length:var(--font-weather-meta)] text-mist"
      data-weather-status
      role="status"
    >
      Connexion à Open-Meteo…
    </p>
    <p class="mt-2 text-[length:var(--font-weather-meta)] text-mist">
      Données{' '}
      <a
        class="underline underline-offset-3"
        href="https://open-meteo.com/"
        target="_blank"
        rel="noreferrer"
      >
        Open-Meteo
      </a>{' '}
      ·{' '}
      <a
        class="underline underline-offset-3"
        href="https://creativecommons.org/licenses/by/4.0/"
        target="_blank"
        rel="noreferrer"
      >
        CC BY 4.0
      </a>{' '}
      · présentation adaptée
    </p>
  </section>
</div>

<style>
  @media (prefers-reduced-motion: reduce) {
    /* Includes hourly icons created by the browser weather renderer. */
    [data-weather] :global([class*='i-meteocons-']) {
      background-image: var(--dayframe-static-icon);
    }
  }
</style>
