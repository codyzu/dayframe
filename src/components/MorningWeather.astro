<div
  data-weather
  class="grid grid-cols-1 gap-4 md:grid-cols-[1fr_1.3fr] lg:gap-5.5"
>
  <section class="surface p-6 lg:px-7" aria-labelledby="weather-title">
    <p class="eyebrow" id="weather-title" data-weather-heading>
      En ce moment
    </p>
    <div class="flex items-center gap-6">
      <span class="text-[91px] tracking-[-6px] leading-[1.15]" data-temperature>
        —°
      </span>
      <span
        class="weather-icon i-meteocons-not-available-fill inline-block size-[116px]"
        data-current-icon
        aria-hidden="true"
      ></span>
    </div>
    <p class="mt-0.5 text-[23px] font-semibold" data-condition>
      Chargement de la météo…
    </p>
    <p class="mt-2 text-base text-mist" data-extremes>
      Ressenti — · Max. — / Min. —
    </p>
    <div class="mt-5 flex items-start gap-3 border-t border-white/20 pt-4">
      <span
        class="mt-2 size-[7px] shrink-0 rounded-full bg-[#f0ce92]"
        aria-hidden="true"
      ></span>
      <div>
        <strong class="text-base font-semibold" data-rain>
          Prévisions en cours de chargement.
        </strong>
        <p class="mt-2 text-base text-mist leading-relaxed" data-summary>
          La météo se met à jour automatiquement.
        </p>
      </div>
    </div>
  </section>
  <section
    class="surface min-w-0 flex flex-col p-5 lg:p-7"
    aria-labelledby="forecast-title"
  >
    <h2 class="text-xl font-semibold tracking-tight" id="forecast-title">
      Les prochaines heures
    </h2>
    <div class="flex-1 flex items-center" data-chart>
      <p class="py-10 text-mist">En attente des prévisions…</p>
    </div>
    <p class="text-sm text-mist" data-weather-status role="status">
      Connexion à Open-Meteo…
    </p>
    <p class="mt-2 text-xs text-mist">
      Données{' '}
      <a
        class="underline underline-offset-3"
        href="https://open-meteo.com/"
        target="_blank"
        rel="noreferrer"
      >
        Open-Meteo
      </a>{' '}
      ·{' '}
      <a
        class="underline underline-offset-3"
        href="https://creativecommons.org/licenses/by/4.0/"
        target="_blank"
        rel="noreferrer"
      >
        CC BY 4.0
      </a>{' '}
      · présentation adaptée
    </p>
  </section>
</div>
