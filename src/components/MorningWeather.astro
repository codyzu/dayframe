---
import Agenda from './Agenda.astro';
---

<div data-weather class="group/weather grid gap-2 data-[observance=true]:gap-1">
  <div class="grid gap-4 min-[1000px]:grid-cols-[0.85fr_1.8fr]">
    <section
      class="surface min-w-0 flex flex-col justify-between px-4 py-3 group-data-[observance=true]/weather:py-1.5"
      aria-labelledby="weather-title"
    >
      <h2
        class="text-[length:var(--font-weather-heading)] font-bold leading-tight"
        id="weather-title"
        data-weather-heading
      >
        En ce moment
      </h2>
      <div class="flex items-center justify-between gap-1">
        <span
          class="text-[length:var(--font-weather-temperature)] font-semibold tracking-[-0.06em] leading-none"
          data-temperature
        >
          —°
        </span>
        <span
          class="weather-icon i-meteocons-not-available-fill inline-block size-[var(--icon-weather-current)] shrink-0 drop-shadow-[0_1px_1px_#182c3580]"
          data-current-icon
          aria-hidden="true"
        ></span>
      </div>
      <p
        class="text-[length:var(--font-weather-description)] font-bold leading-tight"
        data-condition
      >
        Chargement de la météo…
      </p>
      <p
        class="mt-2 text-[length:var(--font-weather-detail)] text-secondary leading-relaxed"
        data-extremes
      >
        Ressenti — · Max. — / Min. —
      </p>
      <p
        class="mt-2 text-[length:var(--font-weather-detail)] text-secondary"
        data-rain
      >
        Prévisions en cours de chargement.
      </p>
    </section>
    <section
      class="surface min-w-0 px-4 py-3 group-data-[observance=true]/weather:py-1.5"
      aria-labelledby="forecast-title"
    >
      <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
        <h2
          class="text-[length:var(--font-weather-heading)] font-bold leading-tight"
          id="forecast-title"
          data-checkpoint-heading
        >
          Les repères de la journée
        </h2>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2" data-checkpoints>
        <p class="text-secondary col-span-2 sm:col-span-4">
          Prévisions en cours de chargement…
        </p>
      </div>
      <div class="mt-3 group-data-[observance=true]/weather:mt-1" data-chart>
        <p class="py-5 text-secondary">En attente des prévisions…</p>
      </div>
    </section>
  </div>
  <div class="grid gap-4 min-[1000px]:grid-cols-[0.85fr_1.8fr]">
    <section
      class="rounded-3xl border border-accent bg-advice text-advice-ink px-4 py-2"
      aria-labelledby="advice-title"
    >
      <h2
        id="advice-title"
        class="text-[length:var(--font-weather-detail)] font-bold leading-tight"
      >
        Conseil du jour
      </h2>
      <p
        class="mt-1 text-[length:var(--font-weather-summary)] font-bold leading-tight"
        data-advice
      >
        Préparons la journée.
      </p>
      <p
        class="mt-1 text-[length:var(--font-weather-detail)] leading-snug"
        data-summary
      >
        La météo se met à jour automatiquement.
      </p>
    </section>
    <Agenda />
  </div>
  <div class="flex flex-wrap justify-between gap-2 text-[0.625rem] leading-tight text-secondary">
    <p class="sr-only" data-weather-status role="status">
      Connexion à Open-Meteo…
    </p>
    <a
      class="inline-flex items-center min-h-6 underline underline-offset-3"
      href="https://open-meteo.com/"
      target="_blank"
      rel="noreferrer"
    >
      Météo : Open-Meteo · CC BY 4.0
    </a>
    <details class="weather-notes">
      <summary class="cursor-pointer min-h-6 flex items-center underline underline-offset-3">
        À propos des prévisions
      </summary>
      <div class="surface p-4 text-base leading-relaxed">
        <p>
          Repères habituels configurables selon le jour. Les événements Google
          restent indépendants de ces habitudes.
        </p>
        <p data-day-context></p>
        <p>
          Calendrier scolaire :{' '}
          <a
            class="underline"
            href="https://data.education.gouv.fr/explore/dataset/fr-en-calendrier-scolaire/"
          >
            Ministère de l’Éducation nationale
          </a>{' '}
          · jours fériés :{' '}
          <a class="underline" href="https://calendrier.api.gouv.fr/">
            DINUM
          </a>{' '}
          · Licence Ouverte.
        </p>
        <p>
          Entre deux heures : température interpolée ; icône de l’heure
          précédente ; pluie = maximum des deux probabilités horaires voisines,
          pas une probabilité à la minute.
        </p>
        <p>
          Barres de pluie : maximum des probabilités horaires de chaque tranche
          de deux heures, pas la probabilité de pluie sur toute la tranche.
          Courbe : température en °C.
        </p>
        <p>
          Données{' '}
          <a
            class="underline"
            href="https://open-meteo.com/"
            target="_blank"
            rel="noreferrer"
          >
            Open-Meteo
          </a>{' '}
          ·{' '}
          <a
            class="underline"
            href="https://creativecommons.org/licenses/by/4.0/"
            target="_blank"
            rel="noreferrer"
          >
            CC BY 4.0
          </a>{' '}
          · présentation adaptée.
        </p>
      </div>
    </details>
  </div>
</div>
<style>
  /* A disclosure overlays secondary methodology without moving the frame's primary content. */
  .weather-notes {
    position: relative;
  }
  .weather-notes > div {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    right: 0;
    width: min(36rem, 85vw);
    z-index: 8;
  }
  /* SVG timelines ignore page animation utilities; use the bundled still SVG. */
  [data-checkpoints] :global([class*='i-meteocons-']) {
    background-image: var(--dayframe-static-icon);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-current-icon] {
      background-image: var(--dayframe-static-icon);
    }
  }
</style>
