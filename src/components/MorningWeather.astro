---
import Agenda from './Agenda.astro';
import WeatherCheckpoints from './WeatherCheckpoints.astro';
import WeatherChart from './WeatherChart.astro';
---

<div data-weather class="group/weather grid gap-2 data-[observance=true]:gap-1">
  <aside
    data-weather-alerts
    data-level="unknown"
    class="relative z-1 rounded-2xl border border-border bg-surface px-4 py-1 text-primary data-[level=yellow]:bg-[#fff0b3] data-[level=orange]:bg-[#ffdab3] data-[level=orange]:border-[#9a4200] data-[level=red]:bg-[#8c1823] data-[level=red]:border-[#8c1823] data-[level=red]:text-white"
    aria-label="Vigilance météorologique"
    aria-live="polite"
  >
    <details class="alert-details relative">
      <summary class="cursor-pointer flex items-baseline justify-between gap-3">
        <span
          data-alert-title
          class="font-bold text-[length:var(--font-weather-detail)] leading-tight"
        >
          Vérification de la vigilance…
        </span>
        <span class="text-xs shrink-0 underline">Détails</span>
      </summary>
      <div class="surface absolute top-full left-0 right-0 z-8 p-4 shadow-lg">
        <p
          data-alert-full
          class="text-base leading-relaxed whitespace-pre-line"
        ></p>
        <p class="mt-2 flex gap-4 text-sm">
          <a class="underline" href="https://meteoalarm.org/en/live/">
            Meteoalarm
          </a>
          <a
            class="underline"
            href="/api/weather-alerts"
            target="_blank"
            rel="noreferrer"
          >
            Flux original
          </a>
        </p>
      </div>
    </details>
    <p data-alert-detail class="text-base leading-tight"></p>
    <a
      class="text-xs underline underline-offset-2"
      href="https://vigilance.meteofrance.fr/fr/haute-savoie"
      target="_blank"
      rel="noreferrer"
    >
      Météo-France via Meteoalarm · consignes
    </a>
  </aside>
  <div
    data-weather-cards
    class="grid gap-4 min-[1000px]:grid-cols-[0.85fr_1.8fr]"
  >
    <section
      class="surface min-w-0 flex flex-col justify-between px-4 py-3 group-data-[observance=true]/weather:py-1.5"
      aria-labelledby="weather-title"
    >
      <h2
        class="text-[length:var(--font-weather-heading)] font-bold leading-tight"
        id="weather-title"
        data-weather-heading
      >
        En ce moment
      </h2>
      <div class="flex items-center justify-between gap-1">
        <span
          class="text-[length:var(--font-weather-temperature)] font-bold tracking-[-0.06em] leading-none"
          data-temperature
        >
          —°
        </span>
        <span
          class="weather-icon i-meteocons-not-available-fill inline-block size-[var(--icon-weather-current)] shrink-0 drop-shadow-[0_1px_1px_#182c3580]"
          data-current-icon
          aria-hidden="true"
        ></span>
      </div>
      <p
        class="text-[length:var(--font-weather-description)] font-bold leading-tight"
        data-condition
      >
        Chargement de la météo…
      </p>
      <p
        class="mt-2 text-[length:var(--font-weather-detail)] text-secondary leading-relaxed"
        data-extremes
      >
        Ressenti — · Max. — / Min. —
      </p>
      <p
        class="mt-2 text-[length:var(--font-weather-detail)] text-secondary"
        data-rain
      >
        Prévisions en cours de chargement.
      </p>
    </section>
    <section
      class="surface min-w-0 px-4 py-3 group-data-[observance=true]/weather:py-1.5"
      aria-labelledby="forecast-title"
    >
      <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
        <h2
          class="text-[length:var(--font-weather-heading)] font-bold leading-tight"
          id="forecast-title"
          data-checkpoint-heading
        >
          Les repères de la journée
        </h2>
      </div>
      <WeatherCheckpoints />
      <WeatherChart />
    </section>
  </div>
  <div
    data-weather-lower
    class="grid gap-4 min-[1000px]:grid-cols-[0.85fr_1.8fr]"
  >
    <section
      class="rounded-3xl border border-accent bg-advice text-advice-ink px-4 py-2"
      aria-labelledby="advice-title"
    >
      <h2
        id="advice-title"
        class="text-[length:var(--font-weather-detail)] font-bold leading-tight"
      >
        Conseil du jour
      </h2>
      <p
        class="mt-1 text-[length:var(--font-weather-summary)] font-bold leading-tight"
        data-advice
      >
        Préparons la journée.
      </p>
      <p
        class="mt-1 text-[length:var(--font-weather-detail)] leading-snug"
        data-summary
      >
        La météo se met à jour automatiquement.
      </p>
    </section>
    <Agenda />
  </div>
  <div
    data-weather-footer
    class="flex flex-wrap justify-between gap-2 text-[0.625rem] leading-tight text-secondary"
  >
    <p class="sr-only" data-weather-status role="status">
      Connexion à Open-Meteo…
    </p>
    <a
      class="inline-flex items-center min-h-4 underline underline-offset-3"
      href="https://open-meteo.com/"
      target="_blank"
      rel="noreferrer"
    >
      Météo : Open-Meteo · CC BY 4.0
    </a>
    <details class="weather-notes">
      <summary class="cursor-pointer min-h-4 flex items-center underline underline-offset-3">
        À propos des prévisions
      </summary>
      <div class="surface p-4 text-base leading-relaxed">
        <p>
          Repères habituels configurables selon le jour. Les événements Google
          restent indépendants de ces habitudes.
        </p>
        <p data-day-context></p>
        <p>
          Calendrier scolaire :{' '}
          <a
            class="underline"
            href="https://data.education.gouv.fr/explore/dataset/fr-en-calendrier-scolaire/"
          >
            Ministère de l’Éducation nationale
          </a>{' '}
          · jours fériés :{' '}
          <a class="underline" href="https://calendrier.api.gouv.fr/">
            DINUM
          </a>{' '}
          · Licence Ouverte.
        </p>
        <p>
          Vigilance :{' '}
          <a class="underline" href="https://vigilance.meteofrance.fr/">
            Météo-France
          </a>
          via{' '}
          <a class="underline" href="https://meteoalarm.org/en/live/">
            Meteoalarm
          </a>
          ·{' '}
          <a
            class="underline"
            href="https://creativecommons.org/licenses/by/4.0/"
          >
            CC BY 4.0
          </a>
          · sélection Haute-Savoie et libellés adaptés. Les horaires de
          vigilance restent indépendants des prévisions Open-Meteo.
          <a class="underline" href="/api/weather-alerts">
            Informations originales
          </a>
          .
        </p>
        <p lang="en" class="text-sm">
          Time delays between this website and the{' '}
          <a class="underline" href="https://meteoalarm.org/en/live/">
            www.meteoalarm.org
          </a>
          website are possible. For the most up-to-date awareness information as
          published by the participating National Meteorological and
          Hydrological Services, please refer to{' '}
          <a class="underline" href="https://meteoalarm.org/en/live/">
            www.meteoalarm.org
          </a>
          .
        </p>
        <p>
          Entre deux heures : température interpolée ; icône de l’heure
          précédente ; pluie = maximum des deux probabilités horaires voisines,
          pas une probabilité à la minute.
        </p>
        <p>
          Barres de pluie : maximum des probabilités horaires de chaque tranche
          de deux heures, pas la probabilité de pluie sur toute la tranche.
          Courbe : température en °C.
        </p>
        <p>
          Données{' '}
          <a
            class="underline"
            href="https://open-meteo.com/"
            target="_blank"
            rel="noreferrer"
          >
            Open-Meteo
          </a>{' '}
          ·{' '}
          <a
            class="underline"
            href="https://creativecommons.org/licenses/by/4.0/"
            target="_blank"
            rel="noreferrer"
          >
            CC BY 4.0
          </a>{' '}
          · présentation adaptée.
        </p>
      </div>
    </details>
  </div>
</div>
<style>
  [data-weather-alerts][data-level='unknown'] {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }
  [data-weather-alerts][data-level='unknown'] [data-alert-title] {
    font-size: 0.875rem;
  }
  [data-weather-alerts][data-level='unknown'] [data-alert-detail],
  [data-weather-alerts][data-level='unknown'] summary > span:last-child {
    display: none;
  }
  /* Fill the frame's available height; the lower cards can grow beneath their
     content while the navigation floats above them without changing layout. */
  @media (min-width: 1000px) {
    [data-weather] {
      flex: 1;
      grid-template-rows: auto auto minmax(min-content, 1fr) auto;
    }
    [data-weather][data-alert='true'] {
      gap: 0.25rem;
    }
    [data-weather][data-alert='true'] [data-weather-cards] > section {
      padding-block: 0.375rem;
    }
    [data-weather][data-alert='true'][data-observance='true']
      [data-weather-cards]
      > section {
      padding-block: 0.25rem;
    }
    [data-weather][data-alert='true'] [data-chart] {
      margin-top: 0.25rem;
    }
    [data-weather][data-alert='true']
      :global([data-checkpoints] [class*='i-meteocons-']) {
      width: 2rem;
      height: 2rem;
    }
    [data-weather-alerts] {
      grid-row: 1;
    }
    [data-weather-cards] {
      grid-row: 2;
    }
    [data-weather-lower] {
      grid-row: 3;
    }
    [data-weather-footer] {
      grid-row: 4;
    }
  }

  /* A disclosure overlays secondary methodology without moving the frame's primary content. */
  .weather-notes {
    position: relative;
  }
  .weather-notes > div {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    right: 0;
    width: min(36rem, 85vw);
    z-index: 8;
  }
  /* SVG timelines ignore page animation utilities; use the bundled still SVG. */
  [data-checkpoints] :global([class*='i-meteocons-']) {
    background-image: var(--dayframe-static-icon);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-current-icon] {
      background-image: var(--dayframe-static-icon);
    }
  }
</style>
