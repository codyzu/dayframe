---
import FutureWeather from './FutureWeather.astro';
import Agenda from './Agenda.astro';
import WeatherChart from './WeatherChart.astro';
import WeatherWindow from './WeatherWindow.astro';
---

<div data-weather class="group/weather min-w-0 flex flex-1 flex-col">
  <aside
    data-weather-alerts
    data-level="unknown"
    class="relative z-2 border-b border-border bg-surface px-4 text-primary data-[level=yellow]:bg-[#fff0b3] data-[level=orange]:bg-[#ffdab3] data-[level=orange]:border-[#9a4200] data-[level=red]:bg-[#8c1823] data-[level=red]:border-[#8c1823] data-[level=red]:text-white"
    aria-label="Vigilance météorologique"
    aria-live="polite"
  >
    <details class="alert-details relative min-w-0 flex-1 basis-full min-[1000px]:basis-auto">
      <summary class="min-h-10 cursor-pointer list-none flex items-center justify-between gap-3 rounded-xl hover:bg-black/5">
        <span
          data-alert-title
          class="font-bold text-[length:var(--font-weather-detail)] leading-tight"
        >
          Vérification de la vigilance…
        </span>
        <span class="min-h-10 shrink-0 inline-flex items-center rounded-xl border border-current bg-white/20 px-4 text-base font-bold">
          Détails{' '}
          <span aria-hidden="true" class="ml-2">
            ▾
          </span>
        </span>
      </summary>
      <div
        data-alert-panel
        class="surface absolute top-full left-0 right-0 z-8 mt-2 max-h-[60vh] overflow-y-auto overscroll-contain p-4 text-primary shadow-lg"
      >
        <div class="mb-3 flex items-center justify-between gap-3">
          <p class="text-base font-bold">Détails de la vigilance</p>
          <button
            type="button"
            data-alert-close
            class="min-h-12 shrink-0 rounded-xl border border-border px-4 py-2 text-base font-bold hover:bg-elevated"
          >
            Fermer
          </button>
        </div>
        <p
          data-alert-full
          class="text-base leading-relaxed whitespace-pre-line"
        ></p>
        <a
          class="mt-3 min-h-12 flex items-center text-sm underline underline-offset-2"
          href="https://vigilance.meteofrance.fr/fr/haute-savoie"
          target="_blank"
          rel="noreferrer"
        >
          Météo-France via Meteoalarm · consignes
        </a>
        <p class="mt-2 flex flex-wrap gap-4 text-sm">
          <a
            class="min-h-12 inline-flex items-center underline"
            href="https://meteoalarm.org/en/live/"
          >
            Meteoalarm
          </a>
          <a
            class="min-h-12 inline-flex items-center underline"
            href="/api/weather-alerts"
            target="_blank"
            rel="noreferrer"
          >
            Flux original
          </a>
        </p>
        <button
          type="button"
          data-location-open
          aria-label="Changer le lieu météo"
          aria-haspopup="dialog"
          class="mt-4 min-h-12 rounded-xl border border-border px-4 py-2 font-bold hover:bg-elevated"
        >
          Changer de lieu météo
        </button>
      </div>
    </details>
    <p data-alert-detail class="text-base leading-tight"></p>
  </aside>
  <div class="journal-layout grid flex-1 min-w-0 min-[1000px]:grid-cols-[3fr_2fr]">
    <div class="min-w-0 flex flex-col min-[1000px]:border-r min-[1000px]:border-border">
      <WeatherWindow />
      <section
        class="border-b border-border bg-[#eaeee2] px-4 py-3 text-primary min-[1000px]:px-8"
        aria-labelledby="advice-title"
      >
        <h2 id="advice-title" data-advice-heading class="sr-only">
          Conseil du jour
        </h2>
        <p
          class="text-[length:var(--font-weather-summary)] group-data-[stale=true]/weather:text-[length:var(--font-weather-detail)] leading-tight"
          data-advice
        >
          Préparons la journée.
        </p>
        <p
          class="mt-1 text-[length:var(--font-weather-detail)] leading-snug text-secondary"
          data-summary
        >
          La météo se met à jour automatiquement.
        </p>
      </section>
      <section
        class="min-w-0 px-4 py-3 min-[1000px]:px-8"
        aria-labelledby="forecast-title"
      >
        <h2
          class="text-[length:var(--font-weather-heading)] font-bold leading-tight"
          id="forecast-title"
        >
          Au fil de la journée
        </h2>
        <WeatherChart />
      </section>
      <div class="mt-auto min-w-0">
        <FutureWeather />
      </div>
      <div
        data-weather-footer
        class="flex flex-wrap justify-between gap-2 px-4 pb-2 text-xs leading-tight text-secondary min-[1000px]:px-8"
      >
        <p class="sr-only" data-weather-status role="status">
          Connexion à Open-Meteo…
        </p>
        <a
          class="inline-flex items-center min-h-4 underline underline-offset-3"
          href="https://open-meteo.com/"
          target="_blank"
          rel="noreferrer"
        >
          Météo : Open-Meteo · CC BY 4.0
        </a>
        <details class="weather-notes">
          <summary class="cursor-pointer min-h-4 flex items-center underline underline-offset-3">
            À propos des prévisions
          </summary>
          <div class="surface p-4 text-base leading-relaxed">
            <p>
              Calendrier scolaire :{' '}
              <a
                class="underline"
                href="https://data.education.gouv.fr/explore/dataset/fr-en-calendrier-scolaire/"
              >
                Ministère de l’Éducation nationale
              </a>{' '}
              · jours fériés :{' '}
              <a class="underline" href="https://calendrier.api.gouv.fr/">
                DINUM
              </a>{' '}
              · Licence Ouverte.
            </p>
            <p>
              Vigilance :{' '}
              <a class="underline" href="https://vigilance.meteofrance.fr/">
                Météo-France
              </a>
              via{' '}
              <a class="underline" href="https://meteoalarm.org/en/live/">
                Meteoalarm
              </a>
              ·{' '}
              <a
                class="underline"
                href="https://creativecommons.org/licenses/by/4.0/"
              >
                CC BY 4.0
              </a>
              · sélection Haute-Savoie et libellés adaptés. Les horaires de
              vigilance restent indépendants des prévisions Open-Meteo.
              <a class="underline" href="/api/weather-alerts">
                Informations originales
              </a>
              .
            </p>
            <p lang="en" class="text-sm">
              Time delays between this website and the{' '}
              <a class="underline" href="https://meteoalarm.org/en/live/">
                www.meteoalarm.org
              </a>
              website are possible. For the most up-to-date awareness
              information as published by the participating National
              Meteorological and Hydrological Services, please refer to{' '}
              <a class="underline" href="https://meteoalarm.org/en/live/">
                www.meteoalarm.org
              </a>
              .
            </p>
            <p>
              Entre deux heures : température interpolée ; icône de l’heure
              précédente ; pluie = maximum des deux probabilités horaires
              voisines, pas une probabilité à la minute.
            </p>
            <p>
              Barres de pluie : maximum des probabilités horaires de chaque
              tranche de deux heures, pas la probabilité de pluie sur toute la
              tranche. Courbe : température en °C.
            </p>
            <p>
              Données{' '}
              <a
                class="underline"
                href="https://open-meteo.com/"
                target="_blank"
                rel="noreferrer"
              >
                Open-Meteo
              </a>{' '}
              ·{' '}
              <a
                class="underline"
                href="https://creativecommons.org/licenses/by/4.0/"
                target="_blank"
                rel="noreferrer"
              >
                CC BY 4.0
              </a>{' '}
              · présentation adaptée.
            </p>
          </div>
        </details>
      </div>
    </div>
    <Agenda />
  </div>
</div>
<style>
  /* A compact warning may wrap at narrow widths; full instructions remain in details. */
  [data-weather-alerts] {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.125rem 0.75rem;
  }
  /* Preserve the full-width touch target without WebKit's native marker. */
  .alert-details > summary::-webkit-details-marker {
    display: none;
  }

  [data-weather-alerts][data-level='unknown'] {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }
  [data-weather-alerts][data-level='unknown'] [data-alert-title] {
    font-size: 0.875rem;
  }
  [data-weather-alerts][data-level='unknown'] [data-alert-detail] {
    display: none;
  }
  .journal-layout {
    --colors-surface: #faf7ef;
    --colors-elevated: #fffdf7;
    --colors-background: #eaece2;
    --colors-primary: #203a33;
    --colors-secondary: #435e55;
    --colors-border: #cbd6c9;
    --colors-temperature: #8d442c;
    --colors-rain: #195d76;
    background: var(--colors-surface);
    color: var(--colors-primary);
  }

  [data-advice] {
    font-family: Georgia, serif;
  }

  /* A disclosure overlays secondary methodology without moving the frame's primary content. */
  .weather-notes {
    position: relative;
  }
  .weather-notes > div {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    right: 0;
    width: min(36rem, 85vw);
    z-index: 8;
  }
</style>
