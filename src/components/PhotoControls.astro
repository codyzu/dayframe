<div
  data-photo-controls
  role="group"
  aria-label="Commandes des photos"
  hidden
  class="photo-tools absolute right-0 bottom-[calc(100%+0.75rem)] flex gap-1 rounded-2xl border border-border bg-surface p-1 text-primary shadow-lg"
>
  <button
    data-photo-previous
    type="button"
    aria-label="Précédente"
    title="Photo précédente"
    disabled
    class="grid size-14 place-items-center rounded-xl hover:bg-background disabled:opacity-40"
  >
    <svg
      viewBox="0 0 24 24"
      class="size-7"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path d="m15 5-7 7 7 7" />
    </svg>
  </button>
  <button
    data-photo-fit
    type="button"
    aria-label="Remplir l’écran"
    aria-pressed="true"
    title="Afficher la photo entière"
    class="grid size-14 place-items-center rounded-xl aria-pressed:bg-primary aria-pressed:text-surface hover:outline hover:outline-border"
  >
    <svg
      viewBox="0 0 24 24"
      class="size-7"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      aria-hidden="true"
    >
      <path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5" />
      <rect x="7" y="7" width="10" height="10" rx="1" />
    </svg>
  </button>
  <button
    data-photo-next
    type="button"
    aria-label="Suivante"
    title="Photo suivante"
    class="grid size-14 place-items-center rounded-xl hover:bg-background"
  >
    <svg
      viewBox="0 0 24 24"
      class="size-7"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path d="m9 5 7 7-7 7" />
    </svg>
  </button>
</div>
<div data-photo-feedback hidden class="photo-feedback flex flex-col gap-2">
  <p
    data-photo-status
    role="status"
    class="rounded-xl border border-border bg-surface px-4 py-3 text-base leading-relaxed text-primary"
  ></p>
  <p
    data-photo-offline-status
    hidden
    role="status"
    class="rounded-xl border border-border bg-surface px-4 py-3 text-base leading-relaxed text-primary"
  ></p>
</div>
<style>
  /* Portrait gets large edge buttons; landscape keeps a compact horizontal
     row. The dock anchors both above navigation without screen-height offsets. */
  @media (orientation: portrait) {
    .photo-tools {
      flex-direction: column;
    }
  }
  [data-photo-status]:empty,
  .photo-feedback:not(:has(p:not(:empty))) {
    display: none;
  }
  /* Useful interruption text remains visible after navigation idles away. */
  .photo-feedback {
    visibility: visible;
  }
</style>
