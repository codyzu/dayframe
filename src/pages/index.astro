---
import BaseLayout from '../layouts/BaseLayout.astro';
import MorningWeather from '../components/MorningWeather.astro';
import ModeNavigation from '../components/ModeNavigation.astro';
import {displayConfig} from '../lib/dashboard/config';
---

<BaseLayout title="À la maison" bodyClass="display-page text-[#f5f6ef]">
  <main
    class="dashboard min-h-screen flex flex-col px-4.5 py-5.5 md:p-6 lg:px-11 lg:pt-7.5 lg:pb-6"
    data-density="standard"
    data-dashboard
    data-mode="morning"
  >
    <header
      data-dashboard-header
      class="flex items-center justify-between gap-3"
    >
      <a
        class="inline-flex items-center gap-2.5 text-lg md:text-[22px] font-bold tracking-tight"
        href="/"
        aria-label="Dayframe, accueil"
      >
        <span
          class="grid place-items-center size-[33px] border border-white/45 rounded-[10px] text-2xl"
          aria-hidden="true"
        >
          d.
        </span>
        dayframe
      </a>
      <span class="border border-white/30 bg-[#091e26]/55 rounded-full px-2 py-1.75 md:px-3 text-[10px] md:text-xs tracking-wide">
        Météo · Annecy
      </span>
    </header>
    <section
      class="morning-panel flex flex-1 flex-col justify-center py-6"
      data-mode-panel="morning"
      aria-labelledby="morning-title"
    >
      <div class="morning-intro flex flex-col-reverse items-start justify-between gap-6 mb-6 md:flex-row md:items-center md:mb-6">
        <div>
          <p class="eyebrow">Un nouveau jour à la maison</p>
          <h1 class="display-title" id="morning-title">
            Bonjour, {displayConfig.location}.
          </h1>
          <p class="mt-3 text-lg text-mist first-letter:uppercase" data-date>
            Chargement de la date…
          </p>
        </div>
        <time class="clock" data-clock aria-label="Heure locale à Annecy">
          --:--
        </time>
      </div>
      <MorningWeather />
    </section>
    <section
      class="grid min-h-[500px] flex-1 place-items-center py-8 text-center md:min-h-0"
      data-mode-panel="photos"
      aria-labelledby="photos-title"
      hidden
    >
      <div class="surface max-w-[720px] px-5 py-7 md:p-11">
        <p class="eyebrow">Vos instants, au quotidien</p>
        <h1 class="display-title" id="photos-title">
          Une place pour vos souvenirs.
        </h1>
        <p class="mx-auto mt-5 mb-7 max-w-lg text-mist leading-relaxed">
          Le diaporama familial sera disponible après la mise en place de
          l’accès privé.
        </p>
        <span class="inline-block rounded-full border border-white/30 bg-[#091e26]/55 px-3 py-2 text-xs">
          Illustration de démonstration
        </span>
      </div>
    </section>
    <section
      class="grid min-h-[500px] flex-1 place-items-center py-8 text-center md:min-h-0"
      data-mode-panel="home"
      aria-labelledby="home-title"
      hidden
    >
      <div class="surface max-w-[720px] px-5 py-7 md:p-11">
        <p class="eyebrow">Le quotidien en douceur</p>
        <h1 class="display-title" id="home-title">
          Bienvenue à la maison.
        </h1>
        <p class="mx-auto mt-5 mb-7 max-w-lg text-mist leading-relaxed">
          Les informations du foyer et les objets connectés trouveront leur
          place ici.
        </p>
        <span class="inline-block rounded-full border border-white/30 bg-[#091e26]/55 px-3 py-2 text-xs">
          Espace en préparation
        </span>
      </div>
    </section>
    <section
      class="grid min-h-[500px] flex-1 place-items-center py-8 text-center md:min-h-0 text-[#aebac3]"
      data-mode-panel="night"
      aria-labelledby="night-title"
      hidden
    >
      <div>
        <p class="eyebrow">La maison se repose</p>
        <time class="clock block mt-5 mb-8" data-clock>
          --:--
        </time>
        <h1 class="text-2xl font-semibold" id="night-title">
          Bonne nuit.
        </h1>
        <p class="mt-5 text-xs">
          Aperçu du mode nuit · luminosité de l’appareil inchangée
        </p>
      </div>
    </section>
    <footer
      data-dashboard-footer
      class="flex flex-col items-center justify-between gap-4 md:flex-row"
    >
      <label class="flex items-center gap-2 text-sm text-mist">
        Texte
        <select
          data-density-select
          aria-label="Taille du texte"
          class="min-h-11 rounded-xl border border-white/30 bg-[#0d2731] px-3 text-base text-white"
        >
          <option value="standard">Standard</option>
          <option value="large">Grand</option>
        </select>
      </label>
      <ModeNavigation />
      <span class="text-[11px] text-mist">Annecy · Europe/Paris</span>
    </footer>
    <noscript>
      <p class="p-2.5 text-xs">
        Activez JavaScript pour l’horloge et le changement de mode. La météo en
        direct nécessite JavaScript.
      </p>
    </noscript>
  </main>
  <script>
    import '../lib/dashboard/controller';
  </script>
</BaseLayout>

<style>
  /* Illustration compositing and kiosk sizing are page-specific, not global resets. */
  :global(.display-page) {
    background: #143c48 url('/annecy.svg') center / cover fixed;
  }
  /* Rem tokens preserve browser font preferences. Layout reflows rather than scaling. */
  .dashboard {
    --font-weather-temperature: 5.6875rem;
    --font-weather-description: 1.4375rem;
    --font-weather-heading: 1.25rem;
    --font-weather-detail: 1rem;
    --font-weather-summary: 1.125rem;
    --font-weather-secondary: 1rem;
    --font-chart-label: 1.125rem;
    --font-chart-time: 1rem;
    --font-navigation: 0.875rem;
    --icon-weather-current: 6rem;
    --icon-weather-hourly: 2.5rem;
    --font-weather-meta: 0.8125rem;

    background: linear-gradient(
      110deg,
      rgba(6, 25, 35, 0.79),
      rgba(9, 34, 43, 0.32)
    );
  }
  .dashboard[data-density='large'] {
    --font-weather-temperature: 6.25rem;
    --font-weather-description: 1.875rem;
    --font-weather-heading: 1.625rem;
    --font-weather-detail: 1.375rem;
    --font-weather-summary: 1.5rem;
    --font-weather-secondary: 1.3125rem;
    --font-chart-label: 1.375rem;
    --font-chart-time: 1.1875rem;
    --font-navigation: 1.1875rem;
    --icon-weather-current: 7.5rem;
    --icon-weather-hourly: 3rem;
    --font-weather-meta: 0.9375rem;
  }
  .dashboard[data-density='large'] .clock {
    font-size: 6.5rem;
  }
  .dashboard[data-mode='night'] {
    background: #080f16;
  }
  @media (min-width: 1000px) {
    .dashboard[data-density='large'] {
      padding: 1.5rem 2rem;
    }
    .dashboard[data-density='large'] .morning-panel {
      padding: 1rem 0;
    }
    .dashboard[data-density='large'] .morning-intro {
      margin-bottom: 1.25rem;
    }
    .dashboard[data-density='large'] .morning-intro .eyebrow {
      font-size: 0.875rem;
      margin-bottom: 0.5rem;
    }
    .dashboard[data-density='large'] .display-title {
      font-size: 2.25rem;
    }
    .dashboard[data-density='large'] [data-date] {
      font-size: 1.375rem;
      margin-top: 0.5rem;
    }
  }
  @media (min-width: 1000px) and (min-height: 700px) {
    .dashboard {
      min-height: 100vh;
    }
  }
</style>
