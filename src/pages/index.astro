---
import BaseLayout from '../layouts/BaseLayout.astro';
import MorningWeather from '../components/MorningWeather.astro';
import PhotoSlideshow from '../components/PhotoSlideshow.astro';
import ModeNavigation from '../components/ModeNavigation.astro';
import {displayConfig} from '../lib/dashboard/config';
---

<BaseLayout
  title="À la maison"
  bodyClass="display-page bg-background text-primary"
  displayManifest
>
  <main
    class="dashboard min-h-screen flex flex-col px-4 py-4 md:p-6"
    data-density="standard"
    data-dashboard
    data-mode="morning"
  >
    <svg
      class="alpine-header"
      viewBox="0 0 800 180"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <circle cx="610" cy="44" r="32" fill="var(--colors-advice)" />
      <path
        d="M0 180 160 65 235 123 360 25 460 125 560 65 800 170V180Z"
        class="fill-alpine-far"
      />
      <path
        d="m0 180 260-55 120 30 150-60 110 55 160-60v90Z"
        class="fill-alpine-near"
      />
    </svg>
    <header
      data-dashboard-header
      class="relative flex items-center justify-between gap-3"
    >
      <a
        class="inline-flex items-center gap-2.5 text-lg md:text-[22px] font-bold tracking-tight"
        href="/"
        aria-label="Dayframe, accueil"
      >
        <span
          class="grid place-items-center size-[33px] border border-accent rounded-[10px] text-2xl text-accent"
          aria-hidden="true"
        >
          d.
        </span>
        dayframe
      </a>
      <span class="border border-border bg-surface rounded-full px-2 py-1.75 md:px-3 text-base tracking-wide">
        <span data-location>Météo · Annecy</span>
      </span>
    </header>
    <section
      class="morning-panel flex flex-1 flex-col py-4 font-bold"
      data-mode-panel="morning"
      aria-labelledby="morning-title"
    >
      <div class="morning-intro flex flex-col-reverse items-start justify-between gap-6 mb-6 md:flex-row md:items-center md:mb-6">
        <div>
          <h1
            data-location-greeting
            class="display-title font-bold"
            id="morning-title"
          >
            Bonjour, {displayConfig.location}.
          </h1>
          <p
            class="mt-2 text-2xl font-bold text-secondary first-letter:uppercase"
            data-date
          >
            Chargement de la date…
          </p>
        </div>
        <time class="clock" data-clock aria-label="Heure locale">
          --:--
        </time>
      </div>
      <MorningWeather />
    </section>
    <PhotoSlideshow />
    <section
      class="grid min-h-[500px] flex-1 place-items-center py-8 text-center md:min-h-0"
      data-mode-panel="night"
      aria-labelledby="night-title"
      hidden
    >
      <div class="w-full px-6 md:px-12">
        <p class="text-3xl md:text-5xl font-semibold">La maison se repose</p>
        <time
          class="block my-8 text-[clamp(6rem,18vw,13rem)] font-semibold tabular-nums leading-none tracking-tight"
          data-clock
        >
          --:--
        </time>
        <h1
          class="text-[clamp(4rem,12vw,9rem)] font-bold leading-none tracking-tight"
          id="night-title"
        >
          Bonne nuit.
        </h1>
      </div>
    </section>
    <footer
      data-dashboard-footer
      class="flex flex-col items-center gap-4 md:flex-row md:grid md:grid-cols-[1fr_auto_1fr]"
    >
      <label class="flex items-center gap-2 text-sm text-secondary md:justify-self-start">
        Texte
        <select
          data-density-select
          aria-label="Taille du texte"
          class="min-h-11 rounded-xl border border-border bg-surface px-3 text-base text-primary"
        >
          <option value="standard">Standard</option>
          <option value="large">Grand</option>
        </select>
      </label>
      <ModeNavigation />
      <button
        type="button"
        data-display-retry
        hidden
        class="min-h-11 rounded-xl border border-border bg-surface px-3 text-sm md:justify-self-end"
      >
        Réessayer la connexion
      </button>
    </footer>
    <noscript>
      <p class="p-2.5 text-xs">
        Activez JavaScript pour l’horloge et le changement de mode. La météo en
        direct nécessite JavaScript.
      </p>
    </noscript>
  </main>
  <script>
    import '../lib/dashboard/controller';
  </script>
</BaseLayout>

<style>
  /* Rem sizing is adjustable in one place; the frame reflows instead of scaling. */
  .dashboard {
    --font-weather-temperature: 5.75rem;
    --font-weather-description: 1.5rem;
    --font-weather-heading: 1.25rem;
    --font-weather-detail: 1.0625rem;
    --font-weather-summary: 1.75rem;
    --font-chart-time: 1rem;
    --font-navigation: 1rem;
    --icon-weather-current: 8rem;
    --font-checkpoint: 1.375rem;
    position: relative;
    background: var(--colors-background);
  }
  .dashboard[data-density='large'] {
    --font-weather-temperature: 6.25rem;
    --font-weather-description: 1.75rem;
    --font-weather-heading: 1.5rem;
    --font-weather-detail: 1.25rem;
    --font-weather-summary: 2rem;
    --font-chart-time: 1.125rem;
    --font-navigation: 1.1875rem;
    --icon-weather-current: 8.25rem;
    --font-checkpoint: 1.5rem;
  }
  .alpine-header {
    position: absolute;
    top: 0;
    right: 0;
    width: 65%;
    height: 140px;
    pointer-events: none;
  }
  .morning-intro {
    position: relative;
  }
  .dashboard[data-mode='photos'] [data-dashboard-header] {
    visibility: hidden;
  }
  .dashboard[data-mode='photos'] [data-dashboard-footer] {
    display: flex;
    position: fixed;
    z-index: 5;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    justify-content: center;
  }
  /* Recovery can hide retry during pointerdown. Keep navigation anchored so
     the button under a finger cannot change before pointerup. */
  .dashboard[data-mode='photos'] [data-dashboard-footer] :global(nav) {
    position: fixed;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    width: max-content;
    max-width: calc(100vw - 2rem);
  }
  .dashboard[data-mode='photos'] [data-display-retry] {
    position: fixed;
    top: 5.5rem;
    right: 1rem;
  }
  .dashboard[data-mode='photos']
    [data-dashboard-footer]
    > :not(nav):not([data-display-retry]) {
    display: none;
  }
  .dashboard[data-mode='night'] {
    background: var(--colors-night);
    color: var(--colors-night-ink);
  }
  .dashboard[data-navigation='hidden'] :global([data-photo-controls]),
  .dashboard[data-navigation='hidden'] :global([data-photo-offline-controls]) {
    visibility: hidden;
  }
  .dashboard[data-mode='night'] [data-dashboard-footer] > label {
    color: var(--colors-night-ink);
  }
  .dashboard[data-mode='night'] [data-dashboard-header],
  .dashboard[data-mode='night'] .alpine-header {
    visibility: hidden;
  }
  /* Controls float on demand instead of reserving an empty navigation row.
     Keep mobile controls in flow, where the page can scroll naturally. */
  @media (min-width: 1000px) {
    /* Keep the weather and agenda readable when a vigilance banner is present:
       reclaim the decorative brand row before compressing any useful content. */
    .dashboard[data-mode='morning'][data-alerts='true']
      [data-dashboard-header] {
      display: none;
    }
    .dashboard[data-mode='morning'][data-alerts='true'] .morning-intro {
      margin-bottom: 0.5rem;
    }
    .dashboard[data-mode='morning'][data-alerts='true'] .clock {
      font-size: 4rem;
    }
    .dashboard[data-mode='morning'][data-alerts='true'] .morning-panel {
      padding: 0.25rem 0;
    }
    .dashboard[data-mode='morning'] [data-dashboard-footer] {
      position: fixed;
      bottom: 0.75rem;
      left: 2rem;
      right: 2rem;
      z-index: 6;
      pointer-events: none;
    }
    .dashboard[data-mode='morning'] [data-dashboard-footer] > :global(*) {
      pointer-events: auto;
    }
    .dashboard[data-mode='morning'] [data-dashboard-footer] > label {
      background: var(--colors-surface);
      border-radius: 1rem;
      padding: 0 0.5rem;
    }
    .dashboard {
      padding: 0.75rem 2rem;
    }
    .morning-panel {
      padding: 0.5rem 0;
    }
    .morning-intro {
      margin-bottom: 0.75rem;
    }
    .display-title {
      font-size: 2rem;
    }
    .clock {
      font-size: 5rem;
    }
  }
</style>
