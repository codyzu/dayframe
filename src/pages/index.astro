---
import {startupGuard} from '../../scripts/offline-build.mjs';
import BaseLayout from '../layouts/BaseLayout.astro';
import MorningWeather from '../components/MorningWeather.astro';
import WeatherLocation from '../components/WeatherLocation.astro';
import PhotoSlideshow from '../components/PhotoSlideshow.astro';
import PhotoControls from '../components/PhotoControls.astro';
import ModeNavigation from '../components/ModeNavigation.astro';
import {displayConfig} from '../lib/dashboard/config';
---

<BaseLayout
  title="À la maison"
  bodyClass="display-page bg-background text-primary"
  displayManifest
>
  {import.meta.env.PUBLIC_OFFLINE_NAVIGATION && (
    <script is:inline set:html={startupGuard()} />
  )}
  <main
    class="dashboard min-h-dvh flex flex-col px-4 py-4 md:p-6 select-none"
    data-density="large"
    data-dashboard
    data-build={import.meta.env.PUBLIC_BUILD_ID}
    data-mode="morning"
    tabindex="-1"
  >
    <svg
      class="alpine-header"
      viewBox="0 0 800 180"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <circle cx="610" cy="44" r="32" fill="var(--colors-advice)" />
      <path
        d="M0 180 160 65 235 123 360 25 460 125 560 65 800 170V180Z"
        class="fill-alpine-far"
      />
      <path
        d="m0 180 260-55 120 30 150-60 110 55 160-60v90Z"
        class="fill-alpine-near"
      />
    </svg>
    <header
      data-dashboard-header
      class="relative flex items-center justify-between gap-3"
    >
      <a
        class="inline-flex items-center gap-2.5 text-lg md:text-[22px] font-bold tracking-tight"
        href="/"
        aria-label="Dayframe, accueil"
      >
        <span
          class="grid place-items-center size-[33px] border border-accent rounded-[10px] text-2xl text-accent"
          aria-hidden="true"
        >
          d.
        </span>
        dayframe
      </a>
      <WeatherLocation />
    </header>
    <section
      class="morning-panel flex flex-1 flex-col py-4 font-bold"
      data-mode-panel="morning"
      aria-labelledby="morning-title"
    >
      <div class="morning-intro flex flex-col-reverse items-start justify-between gap-6 mb-6 md:flex-row md:items-center md:mb-6">
        <div>
          <h1
            data-location-greeting
            class="display-title font-bold"
            id="morning-title"
          >
            Bonjour, {displayConfig.location}.
          </h1>
          <p
            class="mt-2 text-2xl font-bold text-secondary first-letter:uppercase"
            data-date
          >
            Chargement de la date…
          </p>
        </div>
        <time class="clock" data-clock aria-label="Heure locale">
          --:--
        </time>
      </div>
      <MorningWeather />
    </section>
    <PhotoSlideshow />
    <section
      class="grid min-h-[500px] flex-1 place-items-center py-8 text-center md:min-h-0"
      data-mode-panel="night"
      aria-labelledby="night-title"
      hidden
    >
      <div class="w-full px-6 md:px-12">
        <p class="text-3xl md:text-5xl font-semibold">La maison se repose</p>
        <time
          class="block my-8 text-[clamp(6rem,18vw,13rem)] font-semibold tabular-nums leading-none tracking-tight"
          data-clock
        >
          --:--
        </time>
        <h1
          class="text-[clamp(4rem,12vw,9rem)] font-bold leading-none tracking-tight"
          id="night-title"
        >
          Bonne nuit.
        </h1>
      </div>
    </section>
    <footer
      data-dashboard-footer
      class="display-dock flex flex-col items-stretch gap-2"
    >
      <PhotoControls />
      <button
        type="button"
        data-display-retry
        hidden
        class="min-h-12 rounded-xl border border-border bg-surface px-4 py-2 text-base text-primary"
      >
        Réessayer la connexion
      </button>
      <p
        data-touch-hint
        class="rounded-xl bg-surface px-3 py-2 text-center text-xs text-secondary"
      >
        Balayez pour changer d’écran. Photos : touchez les côtés pour parcourir.
      </p>
      <ModeNavigation />
    </footer>
    <noscript>
      <p class="p-2.5 text-xs">
        Activez JavaScript pour l’horloge et le changement de mode. La météo en
        direct nécessite JavaScript.
      </p>
    </noscript>
  </main>
  <script>
    import '../lib/dashboard/controller';
  </script>
</BaseLayout>

<style>
  /* Clip the translated page; a dark backdrop avoids a bright flash into Night. */
  :global(body.display-page) {
    overflow-x: clip;
    background: var(--colors-night);
  }
  /* Use the household’s large type everywhere; narrow layouts reflow. */
  .dashboard {
    touch-action: pan-y pinch-zoom;
    position: relative;
    background: var(--colors-background);
    --font-weather-temperature: 6.25rem;
    --font-weather-description: 1.75rem;
    --font-weather-heading: 1.5rem;
    --font-weather-detail: 1.25rem;
    --font-weather-summary: 2rem;
    --font-chart-time: 1.125rem;
    --font-navigation: 1.1875rem;
    --icon-weather-current: 8.25rem;
    --font-checkpoint: 1.5rem;
  }
  .alpine-header {
    position: absolute;
    top: 0;
    right: 0;
    width: 65%;
    height: 140px;
    pointer-events: none;
  }
  .morning-intro {
    position: relative;
  }
  .dashboard[data-mode='photos'] [data-dashboard-header] {
    visibility: hidden;
  }
  /* One anchored dock keeps navigation geometry identical in every mode.
     Safe-area offsets and mode/visibility selectors belong to this page. */
  .display-dock {
    position: fixed;
    z-index: 6;
    bottom: max(0.75rem, env(safe-area-inset-bottom));
    left: 50%;
    transform: translateX(-50%);
    width: min(24rem, calc(100% - 2rem));
  }
  /* Keep content and native focus scrolling above the fixed dock, including
     wrapped hints/retry. The conservative fallback works before observation. */
  :global(html:has(.dashboard[data-mode='morning'])) {
    scroll-padding-bottom: calc(
      var(--display-dock-height, 14rem) +
        max(0.75rem, env(safe-area-inset-bottom)) + 0.5rem
    );
  }
  .dashboard[data-mode='morning'] {
    padding-bottom: calc(
      var(--display-dock-height, 14rem) +
        max(0.75rem, env(safe-area-inset-bottom)) + 0.5rem
    );
  }
  .dashboard[data-mode='night'] {
    background: var(--colors-night);
    color: var(--colors-night-ink);
  }
  .dashboard[data-mode='night'] .display-dock {
    --colors-background: var(--colors-night);
    --colors-surface: var(--colors-night);
    --colors-primary: var(--colors-night-ink);
    --colors-secondary: var(--colors-night-ink);
    --colors-border: #625b4e;
  }
  .dashboard[data-mode='night'] [data-dashboard-header],
  .dashboard[data-mode='night'] .alpine-header {
    visibility: hidden;
  }
  /* Keep the large greeting clear even when retry and navigation are revealed. */
  .dashboard[data-mode='night'] [data-touch-hint] {
    display: none;
  }
  .dashboard[data-mode='night'] [data-mode-panel='night'] {
    padding-bottom: 3rem;
  }
  /* The large display fits its native canvas. Phones keep readable type and
     enough scroll clearance to reach content above the anchored navigation. */
  @media (min-width: 1000px) {
    :global(html:has(.dashboard[data-mode='morning'])) {
      scroll-padding-bottom: 0.5rem;
    }
    /* Keep the weather and agenda readable when a vigilance banner is present:
       reclaim the decorative brand row before compressing any useful content. */
    .dashboard[data-mode='morning'][data-alerts='true']
      [data-dashboard-header] {
      display: none;
    }
    .dashboard[data-mode='morning'][data-alerts='true'] .morning-intro {
      margin-bottom: 0;
    }
    .dashboard[data-mode='morning'][data-alerts='true'] .clock {
      font-size: 4rem;
    }
    .dashboard[data-mode='morning'][data-alerts='true'] .morning-panel {
      padding: 0;
    }
    .dashboard {
      padding: 0.75rem 2rem;
    }
    .dashboard[data-mode='morning'] {
      padding-bottom: 0.75rem;
    }
    .morning-panel {
      padding: 0.5rem 0;
    }
    .morning-intro {
      margin-bottom: 0;
    }
    .display-title {
      font-size: 2rem;
    }
    .clock {
      font-size: 5rem;
    }
  }
</style>
