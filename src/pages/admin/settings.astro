---
import BaseLayout from '../../layouts/BaseLayout.astro';

const fields = [
  {name: 'location', label: 'Lieu', type: 'text'},
  {name: 'timezone', label: 'Fuseau horaire (ex. Europe/Paris)', type: 'text'},
  {
    name: 'latitude',
    label: 'Latitude',
    type: 'number',
    min: -90,
    max: 90,
    step: 'any',
  },
  {
    name: 'longitude',
    label: 'Longitude',
    type: 'number',
    min: -180,
    max: 180,
    step: 'any',
  },
  {
    name: 'slideshowIntervalSeconds',
    label: 'Durée d’une photo (secondes)',
    type: 'number',
    min: 5,
    max: 3600,
  },
  {
    name: 'overrideTimeoutSeconds',
    label: 'Retour au programme après inactivité (secondes)',
    type: 'number',
    min: 30,
    max: 86_400,
  },
] as const;
---

<BaseLayout
  title="Réglages · Administration"
  bodyClass="bg-background text-primary"
>
  <main data-settings-admin class="mx-auto max-w-3xl px-5 py-10">
    <nav class="flex flex-wrap gap-6 mb-8">
      <a href="/admin/photos" class="min-h-11 underline">
        Photos
      </a>
      <a href="/" class="min-h-11 underline">
        Affichage
      </a>
      <a href="/cdn-cgi/access/logout" class="min-h-11 underline">
        Se déconnecter
      </a>
    </nav>
    <h1 class="text-4xl font-semibold">Réglages de la maison</h1>
    <p data-status role="status" class="my-5 rounded-xl bg-surface p-4">
      Vérification de l’accès…
    </p>
    <a
      href="/admin/settings"
      target="_blank"
      rel="noopener"
      class="min-h-11 inline-flex items-center underline"
    >
      Se reconnecter dans un autre onglet
    </a>
    <button data-reload type="button" class="min-h-11 px-4 underline">
      Actualiser l’accès
    </button>
    <form data-settings-form class="mt-6 space-y-6">
      <fieldset disabled data-controls class="space-y-6">
        <div class="grid gap-5 sm:grid-cols-2">
          {fields.map((field) => (
            <label class="flex flex-col gap-2">
              {field.label}
              <input
                name={field.name}
                type={field.type}
                min={'min' in field ? field.min : undefined}
                max={'max' in field ? field.max : undefined}
                step={'step' in field ? field.step : undefined}
                required
                class="min-h-12 w-full rounded-lg border border-border bg-elevated px-3"
              />
            </label>
          ))}
          <label class="flex flex-col gap-2">
            Cadrage par défaut
            <select
              name="fit"
              class="min-h-12 rounded-lg border border-border bg-elevated px-3"
            >
              <option value="contain">Photo entière</option>
              <option value="cover">Remplir l’écran</option>
            </select>
          </label>
        </div>
        <section aria-labelledby="schedule-title">
          <h2 id="schedule-title" class="text-2xl font-semibold">
            Programme quotidien
          </h2>
          <p class="my-3 text-sm">
            Les plages peuvent traverser minuit mais ne doivent pas se
            chevaucher. Les modes suivent le fuseau horaire choisi. Les réglages
            sont actualisés sur les écrans sous cinq minutes ou à leur réveil.
          </p>
          <div data-schedule class="space-y-3"></div>
          <button data-add-period type="button" class="min-h-11 underline">
            Ajouter une plage
          </button>
        </section>
        <section class="space-y-4" aria-labelledby="day-planning-title">
          <h2 id="day-planning-title" class="text-2xl font-semibold">
            Selon le jour
          </h2>
          <label class="flex items-start gap-3">
            <input data-school-calendar type="checkbox" class="mt-1 size-5" />
            Vacances et jours fériés officiels · Grenoble, zone A
          </label>
          <p class="text-sm text-secondary">
            Les jours fériés, vacances et week-ends utilisent « Jours de repos
            ». Les autres jours suivent leur programme spécifique, ou le
            programme quotidien. Les vacances suspendent les repères des
            activités habituelles. Les événements Google restent affichés.
          </p>
          <label class="flex flex-col gap-2">
            Programme à personnaliser
            <select
              data-day-profile
              class="min-h-12 rounded-lg border border-border bg-elevated px-3"
            >
              <option value="dayOff">
                Jours de repos · week-ends, vacances, fériés
              </option>
              <option value="monday">Lundi</option>
              <option value="tuesday">Mardi</option>
              <option value="wednesday">Mercredi</option>
              <option value="thursday">Jeudi</option>
              <option value="friday">Vendredi</option>
              <option value="saturday">Samedi</option>
              <option value="sunday">Dimanche</option>
            </select>
          </label>
          <p data-day-fallback class="text-sm text-secondary"></p>
          <div data-day-schedule class="space-y-3"></div>
          <button data-add-day-period type="button" class="min-h-11 underline">
            Personnaliser les horaires / ajouter une plage
          </button>
          <button
            data-reset-day-periods
            type="button"
            class="min-h-11 px-3 underline"
          >
            Utiliser le programme quotidien
          </button>
          <h3 class="text-xl font-semibold">Repères météo de ce jour</h3>
          <p class="text-sm text-secondary">
            Jusqu’à quatre horaires : nom et horaire. Ce sont des habitudes
            privées, pas de nouveaux événements Google. Les repères de repos
            remplacent les activités pendant les vacances et jours fériés. Sans
            personnalisation, les repères restent génériques.
          </p>
          <div data-day-checkpoints class="space-y-3"></div>
          <button data-add-checkpoint type="button" class="min-h-11 underline">
            Ajouter un repère météo
          </button>
          <button
            data-reset-checkpoints
            type="button"
            class="min-h-11 px-3 underline"
          >
            Utiliser les repères habituels
          </button>
        </section>
        <button
          type="submit"
          class="min-h-12 rounded-full bg-primary px-6 text-elevated"
        >
          Enregistrer les réglages
        </button>
        <button data-export type="button" class="min-h-12 px-5 underline">
          Exporter les réglages
        </button>
      </fieldset>
    </form>
    <section
      class="mt-10 rounded-xl border border-border p-5"
      aria-labelledby="display-title"
    >
      <h2 id="display-title" class="text-2xl font-semibold">
        Connecter le cadre
      </h2>
      <p class="mt-3">
        Créez une clé puis saisissez-la sur le cadre à l’adresse{' '}
        <a href="/setup" class="underline">
          /setup
        </a>
        . Aucun compte administrateur n’est nécessaire sur le cadre.
      </p>
      <p data-credential-status class="my-4 text-sm"></p>
      <button
        data-issue
        disabled
        type="button"
        class="min-h-12 rounded-full bg-primary px-5 text-elevated disabled:opacity-50"
      >
        Créer ou remplacer la clé
      </button>
      <button
        data-revoke
        disabled
        type="button"
        class="min-h-12 px-4 underline disabled:opacity-50"
      >
        Révoquer la clé
      </button>
      <div data-token-panel hidden class="mt-5 space-y-3">
        <p>
          Cette clé n’apparaît qu’une fois. Sa création a révoqué la précédente.
          Gardez-la privée.
        </p>
        <output
          data-token
          class="block break-all rounded-lg bg-elevated p-4 font-mono text-sm"
        ></output>
        <button data-hide-token type="button" class="min-h-11 underline">
          Masquer la clé
        </button>
      </div>
    </section>
    <section
      data-calendar-admin
      class="mt-10 rounded-xl border border-border p-5"
      aria-labelledby="calendar-title"
    >
      <h2 id="calendar-title" class="text-2xl font-semibold">
        Google Calendar
      </h2>
      <p class="mt-3">
        Connectez un compte ayant accès à votre agenda partagé. Dayframe lit les
        événements sans pouvoir les modifier.
      </p>
      <p class="mt-2 text-sm">
        Les autorisations Google couvrent les agendas accessibles au compte.
        Seuls les deux agendas choisis seront affichés.{' '}
        <a href="/calendar-privacy" class="underline">
          Confidentialité de l’agenda
        </a>
      </p>
      <p data-calendar-result role="status" class="mt-3"></p>
      <p data-calendar-status role="status" class="my-4">
        Vérification de la connexion…
      </p>
      <fieldset disabled class="flex flex-wrap gap-3">
        <button
          data-calendar-connect
          type="button"
          class="min-h-12 rounded-full bg-primary px-5 text-elevated disabled:opacity-50"
        >
          Connecter Google Calendar
        </button>
        <label class="flex w-full flex-col gap-2">
          Agenda à afficher · Famille · rouge
          <select class="min-h-12 w-full min-w-0 rounded-lg border border-border bg-elevated px-3"></select>
        </label>
        <label class="flex w-full flex-col gap-2 text-[#7044a0]">
          Massages · violet
          <select
            data-massage-select
            class="min-h-12 w-full min-w-0 rounded-lg border border-border bg-elevated px-3 text-primary"
          ></select>
        </label>
        <button
          data-calendar-save
          type="button"
          class="min-h-12 px-4 underline disabled:opacity-50"
        >
          Afficher ces agendas
        </button>
        <button
          data-calendar-disconnect
          hidden
          type="button"
          class="min-h-12 px-4 underline"
        >
          Déconnecter Google Calendar
        </button>
      </fieldset>
      <button
        data-calendar-refresh
        type="button"
        class="min-h-11 mt-3 underline"
      >
        Actualiser Google Calendar
      </button>
    </section>
    <template data-checkpoint-template>
      <div class="grid gap-3 rounded-lg bg-surface p-3 sm:grid-cols-[1fr_2fr_auto]">
        <label class="flex flex-col gap-1">
          Horaire
          <input
            data-point-time
            type="time"
            required
            class="min-h-11 min-w-0 rounded bg-elevated px-2"
          />
        </label>
        <label class="flex flex-col gap-1">
          Nom
          <input
            data-point-label
            type="text"
            maxlength="40"
            required
            class="min-h-11 min-w-0 rounded bg-elevated px-2"
          />
        </label>
        <button data-remove type="button" class="min-h-11 underline">
          Retirer
        </button>
      </div>
    </template>
    <template data-period-template>
      <div class="flex flex-wrap items-end gap-3 rounded-lg bg-surface p-3">
        <label class="flex flex-col gap-1">
          Début
          <input
            data-start
            type="time"
            required
            class="min-h-11 rounded bg-elevated px-2"
          />
        </label>
        <label class="flex flex-col gap-1">
          Fin
          <input
            data-end
            type="time"
            required
            class="min-h-11 rounded bg-elevated px-2"
          />
        </label>
        <label class="flex flex-col gap-1">
          Mode
          <select data-mode class="min-h-11 rounded bg-elevated px-2">
            <option value="morning">Matin</option>
            <option value="photos">Photos</option>
            <option value="night">Nuit</option>
          </select>
        </label>
        <button data-remove type="button" class="min-h-11 underline">
          Retirer
        </button>
      </div>
    </template>
  </main>
  <script>
    import '../../lib/dashboard/settings-admin.ts';
    import '../../lib/calendar/admin.ts';
  </script>
</BaseLayout>
