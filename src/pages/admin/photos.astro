---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Photos · Administration"
  bodyClass="bg-[#f5f4ef] text-[#203d43]"
>
  <header class="flex items-center justify-between gap-3 border-b border-[#d7deda] px-5 py-5 md:px-[6vw]">
    <a class="text-2xl font-bold tracking-tight" href="/">
      d. dayframe
    </a>
    <a
      class="min-h-11 inline-flex items-center text-sm underline underline-offset-4"
      href="/"
    >
      Voir l’affichage ↗
    </a>
  </header>
  <main
    data-photo-admin
    class="mx-auto max-w-[1100px] px-5 py-9 md:px-7 md:py-14"
  >
    <p class="eyebrow text-slate-600">Administration · collection privée</p>
    <h1 class="text-[38px] md:text-5xl font-semibold tracking-tight">
      Vos photos
    </h1>
    <p class="mt-3 text-base text-slate-600 md:text-lg">
      Les petits moments méritent le grand écran.
    </p>
    <div class="mt-7 rounded-xl border border-[#ccd9cd] bg-[#e8eee7] p-5 text-sm leading-relaxed">
      <p data-admin-status role="status">
        Vérification de l’accès privé…
      </p>
      <a
        data-admin-login
        href="/admin/photos"
        hidden
        class="mt-3 inline-block min-h-11 underline"
      >
        Se connecter avec Cloudflare Access
      </a>
    </div>
    <section
      aria-labelledby="upload-title"
      class="mt-6 rounded-2xl border border-dashed border-[#9fb5af] bg-[#fffefa] p-6 md:p-8"
    >
      <h2 id="upload-title" class="text-2xl font-semibold">
        Un album à faire vivre
      </h2>
      <p class="mt-3 text-sm text-slate-600">
        Les originaux restent dans votre photothèque. Chaque photo est réduite à
        1 600 px maximum, sans agrandissement, puis convertie en WebP.
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-4">
        <button
          data-choose-files
          disabled
          type="button"
          class="min-h-12 rounded-full bg-[#203d43] px-6 py-3 font-semibold text-white disabled:opacity-50"
        >
          Ajouter des photos
        </button>
        <input
          data-photo-files
          type="file"
          multiple
          accept="image/*,.heic,.heif"
          hidden
        />
        <label class="flex items-center gap-2 text-sm">
          Seuil de similarité
          <input
            data-similarity
            type="number"
            min="0"
            max="16"
            value="6"
            class="min-h-11 w-16 rounded-lg border border-[#9fb5af] bg-white px-2"
          />
        </label>
      </div>
      <p class="mt-3 text-xs text-slate-600">
        Les doublons exacts sont ignorés. Vous choisissez de garder ou passer
        les photos visuellement proches. Sur iPhone, exportez en JPEG si HEIC
        n’est pas reconnu.
      </p>
      <ul
        data-upload-results
        aria-live="polite"
        class="mt-4 space-y-3 text-sm"
      ></ul>
    </section>
    <div class="mt-7 flex flex-wrap items-center justify-between gap-4">
      <div>
        <h2 class="text-2xl font-semibold">La collection</h2>
        <p data-storage class="mt-2 text-sm text-slate-600">
          Stockage non connecté
        </p>
      </div>
      <button
        data-refresh
        disabled
        type="button"
        class="min-h-11 rounded-full border border-[#9fb5af] px-5 text-sm disabled:opacity-50"
      >
        Actualiser
      </button>
    </div>
    <p data-catalog-empty class="mt-6 rounded-xl bg-[#eaece5] p-6">
      Aucune photo pour le moment.
    </p>
    <div
      data-photo-gallery
      class="mt-6 grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-4"
    ></div>
    <template data-photo-card>
      <article class="min-w-0 overflow-hidden rounded-xl border border-[#ccd9cd] bg-[#fffefa]">
        <img
          loading="lazy"
          decoding="async"
          alt="Photo de la collection familiale"
          class="aspect-[4/3] w-full object-cover"
        />
        <div class="p-3">
          <p
            data-photo-details
            class="text-xs leading-relaxed text-slate-600"
          ></p>
          <button
            data-delete
            type="button"
            class="mt-3 min-h-11 w-full rounded-full border border-[#b0786e] px-3 text-sm text-[#7d3024]"
          >
            Supprimer
          </button>
        </div>
      </article>
    </template>
    <dialog
      data-similar-dialog
      class="m-auto w-[min(90vw,650px)] max-h-[90vh] overflow-auto rounded-2xl bg-[#fffefa] p-6 text-[#203d43] backdrop:bg-black/65"
    >
      <form method="dialog">
        <h2 class="text-2xl font-semibold">Des photos se ressemblent</h2>
        <p class="mt-3 text-sm">
          Comparez la nouvelle photo (à gauche) aux photos existantes. Aucune
          photo similaire n’est écartée automatiquement.
        </p>
        <div data-similar-images class="mt-5 grid grid-cols-2 gap-3"></div>
        <div class="mt-5 flex flex-wrap gap-3">
          <button
            value="keep"
            class="min-h-11 rounded-full bg-[#203d43] px-5 text-white"
          >
            Garder cette photo
          </button>
          <button
            value="skip"
            class="min-h-11 rounded-full border border-[#9fb5af] px-5"
          >
            Passer cette photo
          </button>
        </div>
      </form>
    </dialog>
  </main>
  <footer class="p-5 text-center text-xs text-slate-600">
    Dayframe · Une fenêtre sur votre quotidien.
  </footer>
  <script>
    import '../../lib/photos/admin.ts';
  </script>
</BaseLayout>
